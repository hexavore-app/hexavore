<?xml version="1.0" encoding="utf-8"?>
<!--
  Theme de fenetre, distinct du theme Compose.

  Il sert a deux choses : le fond affiche entre le lancement de l'activite et la
  premiere image de Compose, et les barres du systeme. Sans le premier, l'application
  demarre sur un aplat blanc, ce qui se voit beaucoup sur une interface sombre.

  **Parent AppCompat depuis D129**, et c'est le prix du reglage de langue :
  `AppCompatActivity` refuse de demarrer sous un theme qui ne descend pas de
  `Theme.AppCompat`. Ce qu'on perd est nul, ce theme ne servant qu'a peindre un fond ; ce
  qu'on gagne est une langue imposable de l'API 26 a l'API 36.

  **Deux etages.** `Base.Theme.Hexavore` change avec le mode du systeme (values-night) ;
  `Theme.Hexavore` pose les barres, qui ne changent qu'avec la version d'Android.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Hexavore" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/neon_background_light</item>
    </style>

    <!--
      **Les barres se reglent ici, et non dans le code** (D170).

      Le Play Store releve dans le code les appels qu'Android 15 rend obsoletes :
      `Window.setStatusBarColor`, `setNavigationBarColor` et le mode d'encoche
      SHORT_EDGES. Ils venaient tous d'`enableEdgeToEdge()`, qui en a besoin pour les
      versions d'avant 15 ; le theme dit la meme chose sans un appel. A partir d'Android
      15, le systeme ignore ces trois lignes : les barres sont transparentes et l'encoche
      toujours ouverte, quoi qu'on demande.
    -->
    <style name="Theme.Hexavore" parent="Base.Theme.Hexavore">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/system_navigation_bar</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">@integer/system_cutout_mode</item>
    </style>
</resources>
