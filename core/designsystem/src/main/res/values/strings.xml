<?xml version="1.0" encoding="utf-8"?>
<!--
  Design system labels.

  They live here rather than in the calling modules: what TalkBack announces is part of
  the component, just as much as its geometry. A component whose every caller writes its
  own description ends up with six versions of it, five of them wrong.

  This file is the unqualified `values/`, which means it is the fallback for every device
  whose language the application does not speak. The French is in `values-fr/`.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">

    <!-- Gauges: a useful sentence, not "progress bar, 60 %". Both wordings say
         explicitly whether the number is to be reached or not to be exceeded: that is
         the one thing the shape of the bar cannot convey to a screen reader. -->
    <string name="ds_gauge_description">%1$s, %2$d %3$s of a %4$d target, %5$d %%</string>
    <string name="ds_gauge_description_cap">%1$s, %2$d %3$s of a %4$d limit, %5$d %%</string>

    <!-- The value shown to the right of a bar. "max" is the shortest signal there is
         for a limit, and TalkBack reads it out. -->
    <string name="ds_gauge_value">%1$d / %2$d %3$s</string>
    <string name="ds_gauge_value_limit">%1$d / %2$d %3$s max</string>

    <!-- Read by TalkBack on a dimmed button that still responds to a tap: without it,
         the button announces itself like any other and the tap seems to do nothing. -->
    <string name="ds_button_unavailable">unavailable</string>

    <!-- Date picker. A date is chosen, not typed: asking for "YYYY-MM-DD" on a keyboard
         puts a format on the user that the machine can work out for itself. -->
    <string name="ds_date_confirm">Confirm</string>
    <string name="ds_date_cancel">Cancel</string>

    <!-- The four moments of a day, and the rank that tells two dishes of the same moment
         apart. They live here because three surfaces ask for them: the list of dishes,
         the review screen, and the dialog that suggests a name for a favourite. Three
         copies would have ended up saying "Snack" in two places and "Bite" in the
         third. -->
    <string name="ds_moment_breakfast">Breakfast</string>
    <string name="ds_moment_lunch">Lunch</string>
    <string name="ds_moment_snack">Snack</string>
    <string name="ds_moment_dinner">Dinner</string>
    <string name="ds_dish_title_ranked">%1$s %2$d</string>

    <!-- The words for units: the component carries them, the screen carries what it
         measures. -->
    <string name="ds_measure_label">%1$s (%2$s)</string>
    <string name="ds_unit_kg">kg</string>
    <string name="ds_unit_cm">cm</string>
    <string name="ds_unit_pound">lb</string>
    <string name="ds_unit_feet">feet</string>
    <string name="ds_unit_inches">inches</string>
    <string name="ds_unit_gram_short">g</string>
    <string name="ds_unit_gram_spoken">grams</string>
    <string name="ds_unit_millilitre_short">ml</string>
    <string name="ds_unit_millilitre_spoken">millilitres</string>
    <string name="ds_unit_kcal_short">kcal</string>
    <string name="ds_unit_kcal_spoken">kilocalories</string>

    <!-- Where a dish came from. One dish, one source. -->
    <string name="ds_source_manual">Entered by hand</string>
    <string name="ds_source_barcode">Barcode</string>
    <string name="ds_source_photo">Photo</string>
    <string name="ds_source_text">Description</string>
    <string name="ds_source_favorite">Favourite</string>
    <!-- The dashed outline and the wave are invisible to a screen reader: this sentence
         carries the information in their place. -->
    <string name="ds_source_proposed_a11y">%1$s, suggested content, worth checking</string>

    <!-- What an AI outcome tells the user. Here rather than in a screen: docs/02 calls
         for the same messages in both capture dialogs, and the "Test" button in the
         settings asks the same question of the same port. Every sentence says what
         happened and what can be done about it, never a code. -->
    <string name="ds_ai_error_invalid_key">Your key was refused. Check it, then test again.</string>
    <string name="ds_ai_error_quota">This account is out of quota or credit.</string>
    <string name="ds_ai_error_network">No connection. The call never left.</string>
    <string name="ds_ai_error_timeout">The provider did not answer in time.</string>
    <string name="ds_ai_error_vision">This model does not read images.</string>
    <string name="ds_ai_error_not_configured">No provider is configured.</string>
    <string name="ds_ai_error_unreadable">The provider answered something unexpected.</string>
    <string name="ds_ai_error_server">The service is unavailable. Try again later.</string>

    <!-- The weekly adjustment card. Three outcomes, and nothing is ever applied without
         explicit agreement (docs/02). -->
    <string name="ds_adjustment_title">Adjust your target?</string>
    <!-- The pace is written signed rather than told: "you are losing 0.2 kg a week,
         against 0.5 aimed for" becomes false as soon as the two paces point in
         different directions, and then reads backwards. -->
    <string name="ds_adjustment_body">Over the last three weeks: %1$s. The target was aiming for %2$s.</string>
    <string name="ds_adjustment_pace_loss">−%1$.1f kg a week</string>
    <string name="ds_adjustment_pace_gain">+%1$.1f kg a week</string>
    <string name="ds_adjustment_pace_steady">weight holding steady</string>
    <!-- The direction of the correction is said with a verb, never with the sign of a
         number: this is the sentence you tap "Accept" on. -->
    <string name="ds_adjustment_reduce">Lower the target by %1$d kcal?</string>
    <string name="ds_adjustment_raise">Raise the target by %1$d kcal?</string>
    <string name="ds_adjustment_accept">Accept</string>
    <string name="ds_adjustment_ignore">Ignore</string>
    <string name="ds_adjustment_stop">Stop suggesting</string>

</resources>
