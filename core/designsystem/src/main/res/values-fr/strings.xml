<?xml version="1.0" encoding="utf-8"?>
<!--
  Libelles du design system.

  Ils vivent ici et non dans les modules appelants : la phrase annoncee par
  TalkBack fait partie du composant au meme titre que sa geometrie. Un composant
  dont chaque appelant redige sa propre description finit par en avoir six
  versions, dont cinq mauvaises.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="fr">

    <!-- Jauges : une phrase utile, et non « barre de progression, 60 % ». Les deux
         formulations disent explicitement s'il s'agit d'atteindre ou de ne pas
         dépasser : c'est la seule information que la forme de la barre ne peut pas
         transmettre à un lecteur d'écran. -->
    <string name="ds_gauge_description">%1$s, %2$d %3$s sur un objectif de %4$d, %5$d %%</string>
    <string name="ds_gauge_description_cap">%1$s, %2$d %3$s sur une limite de %4$d, %5$d %%</string>

    <!-- Valeur affichée à droite d'une barre. Le « max » d'une limite est le
         signal le plus court qui existe, et il est lu par TalkBack. -->
    <string name="ds_gauge_value">%1$d / %2$d %3$s</string>
    <string name="ds_gauge_value_limit">%1$d / %2$d %3$s max</string>

    <!-- Lu par TalkBack sur un bouton grisé qui reste tapable : sans cela, il
         s'annonce comme n'importe quel bouton et l'appui semble sans effet. -->
    <string name="ds_button_unavailable">indisponible</string>

    <!-- Sélecteur de date. Une date se choisit, elle ne se tape pas : demander
         « AAAA-MM-JJ » au clavier fait porter à l'utilisateur un format que la
         machine sait deviner. -->
    <string name="ds_date_confirm">Valider</string>
    <string name="ds_date_cancel">Annuler</string>

    <!-- Les quatre moments d'une journee, et le rang qui distingue deux plats du
         meme moment. Ils vivent ici parce que trois surfaces les demandent : la liste
         des plats, l'ecran de validation et la boite qui propose un nom de favori.
         Trois copies auraient fini par dire « Gouter » a deux endroits et
         « Collation » au troisieme. -->
    <string name="ds_moment_breakfast">Petit-déjeuner</string>
    <string name="ds_moment_lunch">Déjeuner</string>
    <string name="ds_moment_snack">Goûter</string>
    <string name="ds_moment_dinner">Dîner</string>
    <string name="ds_dish_title_ranked">%1$s %2$d</string>

    <!-- Les mots d unite : le composant les porte, l ecran porte ce qu il mesure. -->
    <string name="ds_measure_label">%1$s (%2$s)</string>
    <string name="ds_unit_kg">kg</string>
    <string name="ds_unit_cm">cm</string>
    <string name="ds_unit_pound">lb</string>
    <string name="ds_unit_feet">pieds</string>
    <string name="ds_unit_inches">pouces</string>
    <string name="ds_unit_gram_short">g</string>
    <string name="ds_unit_gram_spoken">grammes</string>
    <string name="ds_unit_millilitre_short">ml</string>
    <string name="ds_unit_millilitre_spoken">millilitres</string>
    <string name="ds_unit_kcal_short">kcal</string>
    <string name="ds_unit_kcal_spoken">kilocalories</string>

    <!-- Origine d'un plat. Un plat, une source. -->
    <string name="ds_source_manual">Saisie manuelle</string>
    <string name="ds_source_barcode">Code-barres</string>
    <string name="ds_source_photo">Photo</string>
    <string name="ds_source_text">Description</string>
    <string name="ds_source_favorite">Favori</string>
    <!-- Le contour en pointillés et la vague ne se voient pas au lecteur d'écran :
         c'est cette phrase qui porte l'information à leur place. -->
    <string name="ds_source_proposed_a11y">%1$s, contenu proposé à vérifier</string>

    <!-- Ce qu'une issue d'IA dit a l'utilisateur. Ici plutot que dans un ecran :
         docs/02 exige les memes messages pour les deux modales de capture, et le
         bouton « Tester » des reglages pose la meme question au meme port. Chaque
         phrase dit ce qui s'est passe et ce qu'on peut faire, jamais un code. -->
    <string name="ds_ai_error_invalid_key">Votre clé a été refusée. Vérifiez-la, puis testez à nouveau.</string>
    <string name="ds_ai_error_quota">Le quota ou les crédits de ce compte sont épuisés.</string>
    <string name="ds_ai_error_network">Pas de connexion. L\'appel n\'est jamais parti.</string>
    <string name="ds_ai_error_timeout">Le fournisseur n\'a pas répondu à temps.</string>
    <string name="ds_ai_error_vision">Ce modèle ne lit pas les images.</string>
    <string name="ds_ai_error_not_configured">Aucun fournisseur n\'est configuré.</string>
    <string name="ds_ai_error_unreadable">Le fournisseur a répondu quelque chose d\'inattendu.</string>
    <string name="ds_ai_error_server">Le service est indisponible. Réessayez plus tard.</string>

    <!-- La carte d'ajustement hebdomadaire. Trois issues, et rien n'est jamais
         appliqué sans accord explicite (docs/02). -->
    <string name="ds_adjustment_title">Ajuster votre objectif ?</string>
    <!-- Le rythme est écrit signé plutôt que raconté : « vous perdez 0,2 kg par
         semaine, pour 0,5 visé » devient faux dès que les deux rythmes n'ont pas le
         même sens, et se lit alors à l'envers. -->
    <string name="ds_adjustment_body">Sur les trois dernières semaines : %1$s. L\'objectif visait %2$s.</string>
    <string name="ds_adjustment_pace_loss">−%1$.1f kg par semaine</string>
    <string name="ds_adjustment_pace_gain">+%1$.1f kg par semaine</string>
    <string name="ds_adjustment_pace_steady">poids stable</string>
    <!-- Le sens de la correction est dit par un verbe, jamais par le signe d'un
         nombre : c'est la phrase sur laquelle on appuie « Accepter ». -->
    <string name="ds_adjustment_reduce">Réduire l\'objectif de %1$d kcal ?</string>
    <string name="ds_adjustment_raise">Augmenter l\'objectif de %1$d kcal ?</string>
    <string name="ds_adjustment_accept">Accepter</string>
    <string name="ds_adjustment_ignore">Ignorer</string>
    <string name="ds_adjustment_stop">Ne plus proposer</string>

</resources>
