<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">

    <!-- No string mentions an entry mode. It is the same rule as in the code: this
         screen is where the four modes converge, and a text saying "entered by hand"
         would be the first thing to rewrite when search and then AI arrived. -->
    <!-- The day aimed at, shown only when it is not today. Now that a forgotten meal
         can be caught up, a draft can aim at a past day — and it is here, just before
         the write, that this has to be said. -->
    <string name="entry_other_day">Will be noted on %1$s</string>

    <string name="entry_title_new">New entry</string>
    <string name="entry_title_edit">Edit the dish</string>
    <!-- The same screen edits the favourite itself. It has to say so: a title
         announcing "new entry" while you are rewriting a template lies about what the
         next tap will do. -->
    <string name="entry_title_favorite">Edit the favourite</string>

    <string name="entry_field_name">Food</string>

    <!-- What a line suggested by a model says about itself. Two distinct uncertainties:
         what the model understood, and the fact that the quantity comes from a fallback
         rather than from a measured portion (docs/04). -->
    <string name="entry_suggestion">Suggested by AI · %1$d %% confidence</string>
    <string name="entry_suggestion_quantity">estimated quantity</string>
    <!-- The badge docs/04 requires on the step 4 fallback: these figures come from no
         database, and saying so is what makes them usable. -->
    <string name="entry_suggestion_macros">values estimated by AI</string>
    <string name="entry_alternatives">Or maybe:</string>
    <string name="entry_field_quantity">Quantity</string>

    <!-- Every field carries its unit: without it, "Protein 12" reads just as well as
         grams or as a percentage. -->
    <string name="entry_field_calories">Calories (kcal)</string>
    <string name="entry_field_protein">Protein (g)</string>
    <string name="entry_field_carbs">Carbs (g)</string>
    <string name="entry_field_sugars">Sugars (g)</string>
    <string name="entry_field_fat">Fat (g)</string>
    <string name="entry_field_fiber">Fibre (g)</string>

    <!-- The energy worked out from the four other values, under EU regulation 1169/2011.
         The label says where the figure comes from: "Calculate" would suggest nothing
         has been done yet, when the calculation is already there and only waits for
         agreement. -->
    <string name="entry_energy_proposal">From the macros: %1$d kcal</string>
    <!-- What the tap will do. "297 kcal" on its own does not let you guess that the
         value replaces another. -->
    <string name="entry_energy_proposal_a11y">Replace the calories with %1$d, worked out from the macros</string>
    <!-- Fibre was not filled in: it contributed nothing to the calculation, which is
         therefore an undercount. An undercount that announces itself unblocks the line;
         the same value in silence would be one more invented figure. -->
    <string name="entry_energy_without_fiber">Fibre not filled in, so not counted</string>

    <string name="entry_add_line">Add a food</string>
    <string name="entry_remove_line">Remove</string>

    <!-- The suggested name. ANSES labels run long: three of them made a fifty-character
         title that you erase instead of correcting. A number is kept or replaced, it is
         not endured. -->
    <!-- A dish title: suggested from the time of day, correctable, and taken as-is when
         the dish becomes a favourite. The rank tells two dishes of the same moment
         apart, and also serves to suggest "Lunch 2" when "Lunch" is taken. -->
    <string name="entry_dish_title">Dish title</string>
    <string name="entry_title_ranked">%1$s %2$d</string>
    <!-- The swipe is not the only path: a gesture with no visible representation cannot
         be found by someone who does not know it, and is out of reach of a screen
         reader. The name is repeated so that "Remove" designates something. -->
    <string name="entry_remove_line_a11y">Remove the line %1$s</string>

    <string name="entry_total_label">Entry total</string>
    <string name="entry_kcal">%1$d kcal</string>
    <string name="entry_remaining">You will have %1$d kcal left today</string>
    <string name="entry_over">You will go %1$d kcal over today</string>

    <string name="entry_save">Save</string>
    <string name="entry_save_favorite">Save the favourite</string>
    <string name="entry_saving">Saving…</string>
    <!-- A dish reopened and emptied of its lines is deleted: the button says so, rather
         than letting the dish disappear under a "Save" label. -->
    <string name="entry_delete_dish">Delete this dish</string>

    <!-- The star makes the dish a favourite. A single icon for both states:
         material-icons-core has no outline, and the tint never works alone — the state
         is announced to TalkBack. -->
    <string name="entry_favorite">Favourite dish</string>
    <string name="entry_favorite_on">in your favourites</string>
    <string name="entry_favorite_off">not in your favourites</string>
    <string name="entry_favorite_title">Save as a favourite</string>
    <string name="entry_favorite_body">You will find it under this name, ready to replay. Editing a line takes it out.</string>
    <string name="entry_favorite_name">Dish name</string>
    <string name="entry_favorite_name_taken">A favourite dish already has this name.</string>
    <string name="entry_favorite_confirm">Save</string>
    <string name="entry_favorite_cancel">Cancel</string>
    <!-- The counterpart of Save, and the twin of the back gesture. Not "Close": this
         pair of buttons reads together, and "Cancel" says what becomes of the entry
         where "Close" only says what becomes of the screen. -->
    <string name="entry_cancel">Cancel</string>
    <!-- A dimmed button answers the tap; this sentence is what it answers. -->
    <!-- What is missing, named, and for which food. "A field is empty" helps nobody in
         front of twenty-four fields: the screen points at the first one and goes there. -->
    <string name="entry_missing_name">This food is missing its name</string>
    <string name="entry_missing_quantity">The quantity is missing</string>
    <string name="entry_missing_calories">The calories are missing</string>

    <string name="entry_close">Close</string>

    <!-- The photo kept with the dish. Decorative on the home screen, named here: this is
         the only screen where you can act on it. -->
    <string name="entry_photo_a11y">The photo of this dish</string>
    <string name="entry_photo_remove">Remove the photo</string>

    <string name="entry_unavailable_title">Dish unreachable</string>
    <string name="entry_unavailable_body">This dish could not be reopened. It may have been deleted from another screen.</string>

    <string name="entry_error_title">Cannot save</string>
    <string name="entry_error_body">The write did not go through. Your entry is kept exactly as it is.</string>
    <string name="entry_error_retry">Try again</string>

</resources>
