<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">

    <string name="weight_title">Weight log</string>
    <string name="weight_close">Close</string>

    <!-- Weights are always stored in kilograms; imperial is a display conversion, never
         a storage one (docs/07). -->
    <string name="weight_kg">%1$.1f kg</string>
    <string name="weight_pound">%1$.1f lb</string>

    <!-- A curve cannot be read with a finger: the screen reader gets the number of
         readings, and the list below carries the figures. -->
    <plurals name="weight_chart_a11y">
        <item quantity="one">Weight curve, %1$d reading</item>
        <item quantity="other">Weight curve, %1$d readings</item>
    </plurals>
    <string name="weight_axis_label">%1$s · %2$.1f kg</string>

    <!-- A row is a single accessibility node: date, weight, trend, in one sentence
         rather than three stops. -->
    <string name="weight_row_a11y">%1$s, %2$.1f kilograms</string>
    <string name="weight_row_smoothed_a11y">%1$s, %2$.1f kilograms, trend %3$.1f</string>

    <!-- Below three readings in seven days there is nothing to smooth. Saying so saves
         you looking for the highlighted line. -->
    <string name="weight_trend_missing">The trend appears once there are three readings in the same week.</string>

    <!-- An empty list says what to do, not just that it is empty. -->
    <string name="weight_empty_title">No readings yet</string>
    <string name="weight_empty_body">Note your weight whenever you like. Raw weight swings by two kilos with hydration; it is the seven-day average that says where you are heading.</string>

    <!-- A failed read is said out loud, it does not show up as an empty log: an empty
         log is a claim, not an absence of answer. -->
    <string name="weight_error_title">Log unreadable</string>
    <string name="weight_error_body">The read did not go through. Nothing was changed: your readings are where they were.</string>

    <!-- Adding a reading: weight and date, that is all (docs/02). -->
    <string name="weight_add">Add a reading</string>
    <string name="weight_add_title">New reading</string>
    <string name="weight_field">Weight in kilograms</string>
    <string name="weight_field_pound">Weight in pounds</string>
    <string name="weight_date_field">Date of the reading</string>
    <string name="weight_add_confirm">Save</string>
    <string name="weight_add_cancel">Cancel</string>

</resources>
