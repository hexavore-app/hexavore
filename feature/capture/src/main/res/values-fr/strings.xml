<?xml version="1.0" encoding="utf-8"?>
<!--
  Libelles de l'ecran d'IA.

  Un seul ecran depuis D120, la ou il y avait « Photographier » et « Decrire » : les
  deux ne differaient que par ce qu'elles envoyaient.

  Les messages d'erreur n'y sont pas : ils vivent dans le design system, parce que
  docs/02 veut les memes phrases pour la photo, pour la description et pour le
  bouton « Tester » des reglages.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="fr">

    <string name="analyse_title">Analyser un repas</string>
    <string name="analyse_close">Fermer</string>

    <!-- Le cadre vide dit ce qu'on attend de lui. C'est le conseil que docs/02 voulait
         en surimpression de l'apercu camera ; il se lit mieux avant d'appuyer. -->
    <string name="analyse_photo_hint">Photographiez l\'assiette entière, vue de dessus si possible. Ou décrivez votre repas en dessous.</string>
    <string name="analyse_shoot">Prendre une photo</string>
    <string name="analyse_pick">Choisir une image</string>
    <string name="analyse_photo_remove">Retirer la photo</string>
    <string name="analyse_photo_a11y">La photo de votre repas</string>

    <!-- Le meme champ, deux roles : sans photo il decrit, avec photo il precise. Un
         champ qui demanderait « decrivez votre repas » sous une photo ferait tout
         retaper. -->
    <string name="analyse_describe_label">Ce que vous avez mangé</string>
    <string name="analyse_describe_example">Par exemple : deux œufs brouillés, une tranche de pain complet, un verre de jus d\'orange</string>
    <string name="analyse_note_label">Un détail à préciser ? (facultatif)</string>
    <string name="analyse_note_example">Par exemple : l\'assiette fait 24 cm, la sauce est allégée</string>

    <string name="analyse_submit">Analyser</string>
    <string name="analyse_running">Analyse en cours…</string>
    <string name="analyse_cancel">Annuler</string>
    <string name="analyse_manual">Saisir ce repas à la main</string>

    <!-- Dit une fois, avant que la premiere photo parte, et pour une photo seulement :
         celui qui ecrit une phrase sait exactement ce qu'il envoie. Il nomme le
         fournisseur : « votre photo part chez Mistral » se verifie, « chez votre
         fournisseur » non. -->
    <string name="analyse_consent_title">Votre photo va partir</string>
    <string name="analyse_consent">Votre photo part chez %1$s, avec votre clé API. Hexavore n\'a aucun serveur : rien ne passe par nous. Ce que %1$s en garde, et pour combien de temps, relève de ses conditions.</string>
    <string name="analyse_consent_unnamed">Votre photo part chez le fournisseur d\'IA que vous avez configuré, avec votre clé API. Hexavore n\'a aucun serveur : rien ne passe par nous.</string>
    <string name="analyse_consent_accept">J\'ai compris</string>
    <string name="analyse_consent_decline">Annuler</string>

</resources>
