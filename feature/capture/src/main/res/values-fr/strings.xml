<?xml version="1.0" encoding="utf-8"?>
<!--
  Libelles de l'ecran d'IA.

  Un seul ecran depuis D120, la ou il y avait « Photographier » et « Decrire » : les
  deux ne differaient que par ce qu'elles envoyaient.

  Les messages d'erreur n'y sont pas : ils vivent dans le design system, parce que
  docs/02 veut les memes phrases pour la photo, pour la description et pour le
  bouton « Tester » des reglages.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="fr">

    <string name="analyse_title">Analyser un repas</string>
    <string name="analyse_close">Fermer</string>

    <!-- Le cadre vide dit ce qu'on attend de lui. C'est le conseil que docs/02 voulait
         en surimpression de l'apercu camera ; il se lit mieux avant d'appuyer. -->
    <string name="analyse_photo_hint">Prends toute l\'assiette, vue du dessus si possible. Ou décris ton repas juste en dessous.</string>
    <string name="analyse_shoot">Prendre une photo</string>
    <string name="analyse_pick">Choisir une image</string>
    <string name="analyse_photo_remove">Retirer la photo</string>
    <string name="analyse_photo_a11y">La photo de ton repas</string>

    <!-- Le meme champ, deux roles : sans photo il decrit, avec photo il precise. Un
         champ qui demanderait « decrivez votre repas » sous une photo ferait tout
         retaper. -->
    <string name="analyse_describe_label">Ce que tu as mangé</string>
    <string name="analyse_describe_example">Ex. : deux œufs brouillés, une tranche de pain complet, un verre de jus d\'orange</string>
    <string name="analyse_note_label">Une précision ? (facultatif)</string>
    <string name="analyse_note_example">Ex. : assiette de 24 cm, sauce allégée</string>

    <string name="analyse_submit">Analyser</string>
    <string name="analyse_running">On regarde ça…</string>
    <string name="analyse_running_busy">L\'IA est débordée, on réessaie…</string>
    <!-- L'assiette est lue ; ce sont les valeurs de ce que le catalogue ne connaît pas
         qu'on attend. Elle s'attendait derrière un écran noir (D176). -->
    <string name="analyse_running_estimating">On calcule les valeurs…</string>
    <string name="analyse_cancel">Annuler</string>
    <string name="analyse_manual">Saisir ce repas à la main</string>

    <!-- Dit une fois, avant que la premiere photo parte, et pour une photo seulement :
         celui qui ecrit une phrase sait exactement ce qu'il envoie. Il nomme le
         fournisseur : « votre photo part chez Mistral » se verifie, « chez votre
         fournisseur » non. -->
    <string name="analyse_consent_title">Ta photo va être envoyée</string>
    <string name="analyse_consent">Ta photo part chez %1$s, avec ta clé. Hexavore n\'a pas de serveur, rien ne passe par nous. Ce que %1$s en garde, et combien de temps, dépend de ses conditions.</string>
    <string name="analyse_consent_unnamed">Ta photo part chez le fournisseur d\'IA que tu as choisi, avec ta clé. Hexavore n\'a pas de serveur, rien ne passe par nous.</string>
    <string name="analyse_consent_accept">OK, compris</string>
    <string name="analyse_consent_decline">Annuler</string>

</resources>
