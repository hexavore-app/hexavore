<?xml version="1.0" encoding="utf-8"?>
<!--
  Labels for the AI screen.

  A single screen since D120, where there used to be "Take a photo" and "Describe":
  the two differed only in what they sent.

  The error messages are not here: they live in the design system, because docs/02 wants
  the same sentences for the photo, for the description and for the "Test" button of the
  settings.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">

    <string name="analyse_title">Analyse a meal</string>
    <string name="analyse_close">Close</string>

    <!-- The empty frame says what is expected of it. This is the advice docs/02 wanted
         overlaid on the camera preview; it reads better before you press. -->
    <string name="analyse_photo_hint">Photograph the whole plate, from above if you can. Or describe your meal below.</string>
    <string name="analyse_shoot">Take a photo</string>
    <string name="analyse_pick">Choose an image</string>
    <string name="analyse_photo_remove">Remove the photo</string>
    <string name="analyse_photo_a11y">The photo of your meal</string>

    <!-- The same field, two roles: without a photo it describes, with a photo it refines.
         A field asking "describe your meal" under a photo would make you type
         everything again. -->
    <string name="analyse_describe_label">What you ate</string>
    <string name="analyse_describe_example">For example: two scrambled eggs, a slice of wholemeal bread, a glass of orange juice</string>
    <string name="analyse_note_label">Anything to add? (optional)</string>
    <string name="analyse_note_example">For example: the plate is 24 cm across, the sauce is a light one</string>

    <string name="analyse_submit">Analyse</string>
    <string name="analyse_running">Analysing…</string>
    <string name="analyse_cancel">Cancel</string>
    <string name="analyse_manual">Enter this meal by hand</string>

    <!-- Said once, before the first photo leaves, and for a photo only: someone writing
         a sentence knows exactly what they are sending. It names the provider: "your
         photo goes to Mistral" can be checked, "to your provider" cannot. -->
    <string name="analyse_consent_title">Your photo is about to leave</string>
    <string name="analyse_consent">Your photo goes to %1$s, with your API key. Hexavore has no server: nothing passes through us. What %1$s keeps of it, and for how long, is covered by their terms.</string>
    <string name="analyse_consent_unnamed">Your photo goes to the AI provider you configured, with your API key. Hexavore has no server: nothing passes through us.</string>
    <string name="analyse_consent_accept">Understood</string>
    <string name="analyse_consent_decline">Cancel</string>

</resources>
