<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">

    <!-- 1. Welcome. The warning has to be accepted to go on: it is the only blocking
         step of the five. -->
    <string name="onboarding_welcome_title">Welcome to Hexavore</string>
    <!-- D56: the "Skip" is gone, and this sentence was still promising it. A target
         worked out from default values is someone else's target, shown with the
         authority of a personal figure. -->
    <string name="onboarding_welcome_body">Six counters, worked out from your answers. Five questions, one minute.</string>
    <string name="onboarding_disclaimer">Hexavore is a personal tracking tool. It is not a medical device and it does not replace the advice of a health professional.</string>

    <!-- 2. You. Nothing is prefilled: a plausible value on display would be accepted by
         inattention, and the target would be someone else's. -->
    <string name="onboarding_you_title">You</string>
    <!-- D56: the field opens a picker, it is not typed. The format was still being asked
         for under a field that accepts no keystrokes. -->
    <string name="onboarding_birth_date">Date of birth</string>
    <string name="onboarding_sex_label">Sex</string>
    <string name="onboarding_sex_male">Male</string>
    <string name="onboarding_sex_female">Female</string>
    <string name="onboarding_sex_unspecified">I would rather not say</string>
    <string name="onboarding_sex_unspecified_note">We will use a middle estimate, which you can adjust afterwards.</string>
    <string name="onboarding_height">Height (cm)</string>
    <string name="onboarding_weight">Current weight (kg)</string>

    <!-- 4. Target. -->
    <!-- Deux questions la ou il n'y en avait qu'une : un macon sans sport depense plus
         qu'un cadre qui court, et les deux se reconnaissaient dans « modere ». -->
    <!-- Dit une fois, a l'endroit ou l'on commence a saisir : ce qu'on demande ici
         ne part nulle part, et personne n'a a le deviner. -->
    <string name="onboarding_privacy">Everything you enter stays on this phone. No account, no server, nothing sent to anyone.</string>

    <string name="onboarding_work_title">Your working day</string>
    <string name="onboarding_work_body">Eight hours a day, five days a week: this is the floor, and it cannot be guessed from a number of workouts.</string>
    <string name="onboarding_work_desk">Sitting most of the day: office, driving, studying</string>
    <string name="onboarding_work_on_feet">On your feet, no heavy loads: shop, service, teaching</string>
    <string name="onboarding_work_physical">Sustained physical effort: building, handling, farming</string>

    <string name="onboarding_sessions_title">And your sport</string>
    <string name="onboarding_sessions_body">Sessions per week, whatever they are. Counted here once and for all, never added day by day.</string>
    <string name="onboarding_sessions_max">%1$d and more</string>

    <!-- 4. Goal. -->
    <string name="onboarding_objective_title">Your goal</string>
    <string name="onboarding_strategy_lose">Lose weight</string>
    <string name="onboarding_strategy_maintain">Maintain</string>
    <string name="onboarding_strategy_gain">Gain weight</string>
    <string name="onboarding_target_weight">Target weight (kg)</string>

    <!-- Three chips rather than a calendar: an exact date has no value in itself, what
         matters is the pace. The fourth appears only if the safety limits worked out a
         date you can actually reach. -->
    <string name="onboarding_horizon_label">By when?</string>
    <string name="onboarding_horizon_three">In 3 months</string>
    <string name="onboarding_horizon_six">In 6 months</string>
    <string name="onboarding_horizon_twelve">In 12 months</string>
    <string name="onboarding_horizon_reachable">At a safe pace: %1$s</string>
    <!-- The real pace, after the safety limits, not the one you hoped for. -->
    <string name="onboarding_pace">That is about %1$.2f kg a week.</string>

    <!-- 5. Your targets. The application never refuses: it explains and suggests. -->
    <string name="onboarding_result_title">Your targets</string>
    <string name="onboarding_result_unavailable">Answer at least the weight question to see your targets.</string>
    <string name="onboarding_capped">That pace would go past the safety limits. At a safe pace, you would reach your target weight around %1$s.</string>
    <string name="onboarding_use_reachable_date">Use this date</string>
    <string name="onboarding_carbs_low">At this calorie level there is little room left for carbs once protein, fat and fibre are covered. A higher target would be easier to hold.</string>

    <string name="onboarding_goal_calories">Calories: %1$d kcal</string>
    <string name="onboarding_goal_protein">Protein: %1$d g</string>
    <string name="onboarding_goal_fiber">Fibre: %1$d g</string>
    <string name="onboarding_goal_carbs">Carbs: %1$d g max</string>
    <string name="onboarding_goal_sugars">Sugars: %1$d g max</string>
    <string name="onboarding_goal_fat">Fat: %1$d g max</string>

    <!-- One sentence per counter: a figure without a reason is a figure you ignore. -->
    <string name="onboarding_why_calories">Your estimated expenditure, adjusted to your deadline.</string>
    <string name="onboarding_why_protein">Worked out on your target weight, to preserve lean mass.</string>
    <string name="onboarding_why_fiber">14 g per 1,000 kcal, never cut back in favour of carbs.</string>
    <string name="onboarding_why_carbs">What is left of the budget, once fibre is deducted.</string>
    <string name="onboarding_why_sugars">The WHO ceiling, applied to total sugars, so stricter.</string>
    <string name="onboarding_why_fat">A limit not to be exceeded. The minimum your body needs is already covered.</string>

    <!-- What a dimmed button answers when tapped. It says what is missing, not that
         something is missing: "complete the form" helps nobody. -->
    <string name="onboarding_blocked_disclaimer">Accept the warning to continue.</string>
    <string name="onboarding_blocked_identity">Fill in your date of birth, your sex, your height and your weight.</string>
    <string name="onboarding_blocked_activity">Choose the level that best describes your weeks.</string>
    <string name="onboarding_blocked_objective">Choose a goal, then a target weight and a deadline.</string>

    <string name="onboarding_next">Continue</string>
    <string name="onboarding_back">Back</string>
    <string name="onboarding_start">Let\'s go</string>
    <string name="onboarding_save_failed">Saving did not go through. Your answers are kept exactly as they are.</string>

</resources>
