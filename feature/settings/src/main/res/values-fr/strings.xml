    <string name="appearance_language_note">« Suivre le système » prend la première langue de ton téléphone que parle Hexavore, sinon l\'anglais. Les noms d\'aliments suivent : la table de l\'ANSES existe dans les deux langues.</string>

    <string name="appearance_theme_title">Thème</string>
    <string name="appearance_theme_light">Clair</string>
    <string name="appearance_theme_dark">Sombre</string>
    <string name="appearance_theme_system">Suivre le système</string>
    <string name="appearance_units_title">Unités</string>
    <!-- Le style d'affichage des plats. Deux styles et non une densite : ce qui les
         distingue est ce qu'on lit, pas une hauteur de ligne. -->
    <string name="appearance_dishes_title">Affichage des plats</string>
    <string name="appearance_dishes_simple">Simplifié</string>
    <string name="appearance_dishes_detailed">Détaillé</string>
    <string name="appearance_dishes_note">Simplifié : le titre du plat, l\'heure, les calories et les apports. Détaillé : en plus, la liste des aliments.</string>

    <string name="appearance_units_metric">Métrique (g, ml, kg, cm)</string>
    <string name="appearance_units_imperial">Impérial (oz, fl oz, lb, pieds et pouces)</string>
    <string name="appearance_units_note">Change l\'affichage et la saisie. Tes données ne bougent pas : un plat noté en grammes reste en grammes.</string>
    <string name="appearance_theme_note">« Suivre le système » suit le réglage d\'Android.</string>

    <!-- ===== Pastilles ============================================================
         Aucune notification systeme : ce sont des points colorés qu'on voit en ouvrant
         l'application. Chacune designe une situation, jamais un message empile. -->
    <string name="settings_notices_title">Notifications</string>
    <string name="settings_notices_subtitle">Les pastilles qui te signalent quelque chose</string>

    <string name="notices_title">Notifications</string>
    <string name="notices_close">Fermer</string>
    <!-- Les pastilles, et elles seules (D162) : l'écran porte aussi les rappels, qui
         sonnent et demandent une permission, et la phrase semblait parler d'eux. -->
    <string name="notices_intro">Les pastilles sont juste des points de couleur dans l\'appli : pas de son, rien sur l\'écran verrouillé, aucune permission. Chacune s\'éteint quand le souci est réglé. Seuls les rappels, plus bas, sonnent en dehors de l\'appli.</string>
    <string name="settings_section_flagged">Un truc à régler ici</string>
    <string name="notices_active_now">Allumée en ce moment</string>

    <string name="notices_ai_absent_title">Pas d\'IA configurée</string>
    <!-- La barre n'est plus grisée sans clé : elle passe au rouge et dit ce qui manque (D162). -->
    <string name="notices_ai_absent_body">Sur l\'icône du profil, tant qu\'il n\'y a pas de clé. Sans elle, la barre d\'analyse passe en rouge et dit ce qui manque.</string>

    <string name="notices_ai_rejected_title">Clé d\'IA refusée</string>
    <string name="notices_ai_rejected_body">Sur l\'icône du profil, quand la dernière analyse a été refusée. Sinon, l\'analyse arrêterait de marcher sans prévenir.</string>

    <string name="notices_weight_title">Pas de pesée depuis une semaine</string>
    <!-- La tendance ne se tait plus depuis D159 : c'est l'adaptation qui manque d'appui (D162). -->
    <string name="notices_weight_body">Sur l\'icône du poids. Sans pesées régulières, l\'ajustement de la semaine n\'a rien sur quoi s\'appuyer.</string>

    <string name="notices_yesterday_title">Rien de noté hier</string>
    <string name="notices_yesterday_body">Sur la pastille d\'hier dans le calendrier. Touche ce jour pour ajouter le repas oublié.</string>
    <!-- Le chemin du retour de « Ne plus afficher d'astuces » (D179). -->
    <string name="notices_tips_title">Astuces à l\'ouverture</string>
    <string name="notices_tips_body">De temps en temps, à l\'ouverture, une astuce qu\'on ne devine pas. Chacune une seule fois, jamais deux d\'un coup.</string>

    <!-- L\'analyse approfondie : le modele interroge le catalogue avant de conclure,
         au lieu de laisser un score de ressemblance choisir a sa place. -->
    <string name="ai_deep_title">Analyse approfondie</string>
    <string name="ai_deep_body">Le modèle fouille le catalogue et choisit lui-même chaque aliment. Toujours actif si le fournisseur sait utiliser des outils : sans ça, les aliments introuvables reviendraient sans valeurs.</string>
    <string name="ai_deep_unavailable">Ce fournisseur ne sait pas utiliser d\'outils. Les aliments qu\'il ne trouve pas seront estimés, et signalés comme tels.</string>

    <!-- Les rappels : la seconde moitie de cet ecran. Ils sonnent dehors, la ou les
         pastilles se voient en ouvrant l'application. -->
    <string name="reminders_title">Rappels</string>
    <string name="reminders_intro">Eux sonnent vraiment, hors de l\'appli. Chacun se tait s\'il n\'a rien à dire : pas de rappel du déjeuner si tu l\'as déjà noté.</string>
    <string name="reminders_blocked">Android bloque les notifications d\'Hexavore. Les rappels sont réglés, mais rien ne sonnera.</string>
    <string name="reminders_allow">Autoriser les notifications</string>
    <string name="reminders_breakfast_title">Petit-déjeuner</string>
    <string name="reminders_lunch_title">Déjeuner</string>
    <string name="reminders_dinner_title">Dîner</string>
    <string name="reminders_streak_title">Série en jeu</string>
    <string name="reminders_meal_body">Se tait dès que ce repas est noté.</string>
    <string name="reminders_streak_body">Le soir, si rien n\'est noté et que tu as une série en cours.</string>
    <string name="settings_favorites_title">Favoris</string>
    <string name="settings_favorites_subtitle">Tes plats enregistrés, et de quoi les modifier</string>
    <string name="settings_favorites_edit">Modifier ce favori</string>
    <string name="settings_favorites_empty">Pas encore de favori. Touche l\'étoile sur un plat pour le garder, il reviendra sous le bouton +.</string>
    <string name="settings_contact_title">Contact</string>
    <string name="settings_contact_subtitle">Le code, le site, nous écrire, nous noter</string>
    <string name="settings_contact_intro">Hexavore est un logiciel libre. Un bug, une idée, un petit mot : tout nous arrive.</string>
    <string name="settings_contact_site">Le site</string>
    <string name="settings_contact_github">Le code et les tickets</string>
    <string name="settings_contact_mail">Nous écrire</string>
    <!-- La demande d'avis de l'ouverture, toujours à portée (D179). -->
    <string name="settings_contact_rate">Noter Hexavore sur le Play Store</string>
    <!-- Quand rien sur le téléphone ne sait ouvrir l'adresse d'une carte, de Contact
         comme d'À propos (D162). Elle renvoie à l'adresse, écrite sur la carte pour
         cette raison. -->
    <string name="settings_link_unavailable">Aucune appli de ce téléphone ne sait ouvrir ce lien. L\'adresse est sur la carte, tu peux la recopier.</string>

