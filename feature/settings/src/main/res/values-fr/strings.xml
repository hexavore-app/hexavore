    <!-- ===== Récupérer une clé =====================================================
         Un ecran, et non un lien discret : il annonce la sortie de l'application, dit
         qu'elle ne peut pas etre faite a la place de quelqu'un, et qu'elle ne se fait
         qu'une fois (D156). Les etapes sont courtes et ne dependent d'aucun libelle
         precis : les consoles changent de forme plusieurs fois par an. -->
    <string name="ai_get_title">Récupérer une clé</string>
    <string name="ai_get_close">Fermer</string>
    <string name="ai_get_warning_title">Tu vas sortir d\'Hexavore</string>
    <string name="ai_get_warning_body">La clé se crée sur le site de %1$s. Personne ne peut le faire pour toi : il faut un compte à ton nom, et c\'est %1$s qui te donne la clé.</string>
    <string name="ai_get_warning_once">Deux minutes, et une seule fois.</string>
    <string name="ai_get_steps_title">Ce que tu vas faire</string>
    <string name="ai_get_step_open">Appuie sur le bouton en bas : le site de %1$s s\'ouvre dans ton navigateur.</string>
    <string name="ai_get_step_account_free">Connecte-toi, ou crée un compte. Pas besoin de carte bancaire.</string>
    <string name="ai_get_step_account">Connecte-toi, ou crée un compte.</string>
    <string name="ai_get_step_create">Cherche le bouton pour créer une clé, souvent en anglais : « Create API key ».</string>
    <string name="ai_get_step_paste">Copie la clé, reviens dans Hexavore et appuie sur « Coller la clé ».</string>
    <string name="ai_get_step_copy_once">Copie-la avant de quitter la page : certains fournisseurs ne l\'affichent qu\'une fois.</string>
    <string name="ai_get_privacy">La clé reste chiffrée sur ton téléphone. Les demandes partent directement chez %1$s : Hexavore n\'a pas de serveur et ne voit rien passer.</string>
    <string name="ai_get_open">Ouvrir le site de %1$s</string>
    <string name="ai_get_back">Revenir</string>

