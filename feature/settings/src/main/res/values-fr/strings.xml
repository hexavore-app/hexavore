    <!-- L'écran des fournisseurs. -->
    <string name="ai_title">Intelligence artificielle</string>
    <!-- Ce que personne ne lit dans un paragraphe : c'est gratuit. La reponse qui
         decide si quelqu'un configure une cle ou referme l'ecran (D138). -->
    <string name="ai_free_title">%1$s est gratuit</string>
    <!-- En mots de tous les jours (D178) : « palier » et « usage courant » ne disaient pas
         que les repas d'une journée y tiennent largement. -->
    <string name="ai_free_body">Un compte suffit, et l\'offre gratuite couvre largement les repas d\'une journée : ni abonnement, ni carte bancaire. La clé, un code personnel à coller ici, se récupère en deux minutes, une seule fois.</string>
    <!-- Ce qu'est une clé, avant de dire où elle reste (D178). -->
    <string name="ai_intro">Une clé est un code personnel qui relie Hexavore à votre compte chez un fournisseur d\'IA. Elle reste sur ce téléphone, chiffrée par son trousseau, et les appels partent directement chez lui : Hexavore n\'a pas de serveur.</string>

    <!-- Le compteur d'usage. La date du releve accompagne le montant : docs/05 veut
         que la table de tarifs soit datee et signalee comme indicative, parce qu'une
         estimation perimee presentee comme exacte serait pire que pas d'estimation. -->
    <string name="ai_usage_billing">Hexavore n\'estime aucun coût. Seule la facture de votre fournisseur fait foi.</string>
    <string name="ai_usage_title">Ce que vos analyses ont consommé</string>
    <plurals name="ai_usage_line">
        <item quantity="one">%1$s · %2$s · %3$d appel, %4$d jetons</item>
        <item quantity="other">%1$s · %2$s · %3$d appels, %4$d jetons</item>
    </plurals>
