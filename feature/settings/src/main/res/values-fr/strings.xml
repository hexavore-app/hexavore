    <string name="appearance_title">Apparence</string>
    <string name="appearance_close">Fermer</string>

    <!-- La langue. La premiere des quatre, parce que c'est elle qui decide comment les
         trois autres se lisent. -->
    <string name="appearance_language_title">Langue</string>
    <string name="appearance_language_system">Suivre le système</string>
    <!-- Chaque langue est ecrite dans elle-meme, dans les deux fichiers. Qui cherche sa
         langue ne sait pas lire celle qui est a l'ecran, c'est justement pour ca qu'il la
         cherche : « English » en dit donc plus que « Anglais » ne le ferait jamais. -->
    <string name="appearance_language_en">English</string>
    <string name="appearance_language_fr">Français</string>
    <string name="appearance_language_note">« Suivre le système » prend les langues réglées sur votre téléphone, dans leur ordre, et retient la première que parle Hexavore. L\'anglais sinon. Les noms d\'aliments suivent : la table de l\'ANSES publie ses 3 484 libellés dans les deux langues.</string>

    <string name="appearance_theme_title">Thème</string>
    <string name="appearance_theme_light">Clair</string>
    <string name="appearance_theme_dark">Sombre</string>
    <string name="appearance_theme_system">Suivre le système</string>
    <string name="appearance_units_title">Unités</string>
    <!-- Le style d'affichage des plats. Deux styles et non une densite : ce qui les
         distingue est ce qu'on lit, pas une hauteur de ligne. -->
    <string name="appearance_dishes_title">Affichage des plats</string>
    <string name="appearance_dishes_simple">Simplifié</string>
    <string name="appearance_dishes_detailed">Détaillé</string>
    <string name="appearance_dishes_note">Le simplifié donne le titre du plat, son heure, ses calories et ses apports. Le détaillé y ajoute la liste de ses aliments.</string>

    <string name="appearance_units_metric">Métrique (g, ml, kg, cm)</string>
    <string name="appearance_units_imperial">Impérial (oz, fl oz, lb, pieds et pouces)</string>
    <string name="appearance_units_note">Ce réglage change l\'affichage et la saisie. Vos données ne bougent pas : un plat noté en grammes garde ses grammes.</string>
    <string name="appearance_theme_note">« Suivre le système » reprend le réglage d\'Android et bascule avec lui.</string>

    <!-- ===== Pastilles ============================================================
         Aucune notification systeme : ce sont des points colorés qu'on voit en ouvrant
         l'application. Chacune designe une situation, jamais un message empile. -->
    <string name="settings_notices_title">Notifications</string>
    <string name="settings_notices_subtitle">Les pastilles qui signalent ce qu\'il y a à faire</string>

    <string name="notices_title">Notifications</string>
    <string name="notices_close">Fermer</string>
    <!-- Les pastilles, et elles seules (D162) : l'écran porte aussi les rappels, qui
         sonnent et demandent une permission, et la phrase semblait parler d'eux. -->
    <string name="notices_intro">Les pastilles sont des points colorés dans l\'application, rien de plus : aucune sonnerie, rien sur l\'écran de verrouillage, aucune permission. Chacune s\'éteint quand la situation qu\'elle signale a cessé. Seuls les rappels, plus bas, sonnent hors de l\'application.</string>
    <string name="settings_section_flagged">Quelque chose à régler ici</string>
    <string name="notices_active_now">Allumée en ce moment</string>

    <string name="notices_ai_absent_title">Aucune IA configurée</string>
    <!-- La barre n'est plus grisée sans clé : elle passe au rouge et dit ce qui manque (D162). -->
    <string name="notices_ai_absent_body">Sur l\'icône du profil, tant qu\'aucune clé d\'API ne sert. Sans elle, la barre d\'analyse s\'affiche en rouge et dit ce qui manque.</string>

    <string name="notices_ai_rejected_title">Clé d\'API refusée</string>
    <string name="notices_ai_rejected_body">Sur l\'icône du profil, quand le dernier appel d\'analyse a été refusé. Sans elle, l\'analyse cesse de fonctionner sans que rien ne le dise.</string>

    <string name="notices_weight_title">Pas de pesée depuis une semaine</string>
    <!-- La tendance ne se tait plus depuis D159 : c'est l'adaptation qui manque d'appui (D162). -->
    <string name="notices_weight_body">Sur l\'icône du journal de poids. Sans pesées régulières, l\'adaptation hebdomadaire n\'a rien sur quoi s\'appuyer, et ne peut rien proposer.</string>

    <string name="notices_yesterday_title">Hier n\'a rien de noté</string>
    <string name="notices_yesterday_body">Sur la pastille d\'hier dans le calendrier. Toucher cette journée permet d\'y noter le repas oublié.</string>

    <!-- L\'analyse approfondie : le modele interroge le catalogue avant de conclure,
         au lieu de laisser un score de ressemblance choisir a sa place. -->
    <string name="ai_deep_title">Analyse approfondie</string>
    <string name="ai_deep_body">Le modèle interroge le catalogue et choisit lui-même la fiche de chaque aliment. Elle est toujours active dès que le fournisseur sait appeler des outils : sans elle, les aliments que le catalogue ne rejoint pas reviennent sans aucune valeur.</string>
    <string name="ai_deep_unavailable">Le fournisseur actif ne sait pas appeler d\'outils. Les aliments qu\'il ne rejoint pas seront estimés, et signalés comme tels.</string>

    <!-- Les rappels : la seconde moitie de cet ecran. Ils sonnent dehors, la ou les
         pastilles se voient en ouvrant l'application. -->
    <string name="reminders_title">Rappels</string>
    <string name="reminders_intro">Ceux-là sonnent vraiment, hors de l\'application. Chacun se tait quand il n\'a rien à dire : le rappel du déjeuner saute une journée dont le déjeuner est déjà noté.</string>
    <string name="reminders_blocked">Android bloque les notifications d\'Hexavore. Les rappels sont réglés, mais rien ne sonnera.</string>
    <string name="reminders_allow">Autoriser les notifications</string>
    <string name="reminders_breakfast_title">Petit-déjeuner</string>
    <string name="reminders_lunch_title">Déjeuner</string>
    <string name="reminders_dinner_title">Dîner</string>
    <string name="reminders_streak_title">Série en jeu</string>
    <string name="reminders_meal_body">Muet dès que ce repas est noté.</string>
    <string name="reminders_streak_body">Le soir, quand rien n\'est noté et qu\'une série court.</string>
    <string name="settings_favorites_title">Favoris</string>
    <string name="settings_favorites_subtitle">Les plats enregistrés, et de quoi les corriger.</string>
    <string name="settings_favorites_edit">Modifier ce favori</string>
    <string name="settings_favorites_empty">Aucun favori. Touchez l\'étoile sur un plat pour l\'enregistrer ; il reviendra sous le bouton +.</string>
    <string name="settings_contact_title">Contact</string>
    <string name="settings_contact_subtitle">Le code, le site, et où écrire.</string>
    <string name="settings_contact_intro">Hexavore est un logiciel libre. Un défaut, une idée, un mot : les trois nous arrivent.</string>
    <string name="settings_contact_site">Le site</string>
    <string name="settings_contact_github">Le code, et les tickets</string>
    <string name="settings_contact_mail">Nous écrire</string>
    <!-- Quand rien sur le téléphone ne sait ouvrir l'adresse d'une carte, de Contact
         comme d'À propos (D162). Elle renvoie à l'adresse, écrite sur la carte pour
         cette raison. -->
    <string name="settings_link_unavailable">Aucune application de ce téléphone ne sait ouvrir ce lien. L\'adresse est écrite sur la carte : vous pouvez la recopier.</string>

