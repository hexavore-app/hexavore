    <string name="ai_reveal">Afficher la clé</string>
    <string name="ai_hide">Masquer la clé</string>
    <!-- Un seul geste la ou il y en avait deux : valider teste, puis enregistre, et
         s'arrete au premier refus (D156). « Tester » et « Effacer la cle » sont partis. -->
    <string name="ai_validate">Valider la clé</string>
    <string name="ai_validating">Vérification…</string>
    <string name="ai_in_use">Utilisé</string>
    <string name="ai_advanced">Réglages avancés</string>

    <!-- Le bouton qui ouvre l'ecran de recuperation. Le seul mur sur lequel tous les
         testeurs se sont arretes etait un lien souligne en petit (D156). -->
    <string name="ai_key_get">Récupérer la clé</string>

    <!-- Coller demande un appui long puis une bulle du systeme a viser, sur un champ
         masque par des points : le geste que les testeurs ratent au retour du
         navigateur. Un bouton le reduit a un appui (D157). -->
    <string name="ai_key_paste">Coller la clé</string>
    <string name="ai_key_paste_empty">Rien à coller : copiez d\'abord la clé sur le site, puis revenez ici.</string>

    <!-- ===== Récupérer une clé =====================================================
         Un ecran, et non un lien discret : il annonce la sortie de l'application, dit
         qu'elle ne peut pas etre faite a la place de quelqu'un, et qu'elle ne se fait
         qu'une fois (D156). Les etapes sont courtes et ne dependent d'aucun libelle
         precis : les consoles changent de forme plusieurs fois par an. -->
    <string name="ai_get_title">Récupérer une clé</string>
    <string name="ai_get_close">Fermer</string>
    <string name="ai_get_warning_title">Vous allez sortir d\'Hexavore</string>
    <string name="ai_get_warning_body">La clé se crée chez %1$s, sur son site. Personne ne peut le faire à votre place : il faut un compte à votre nom, et c\'est %1$s qui vous remet la clé.</string>
    <string name="ai_get_warning_once">Comptez deux minutes — et c\'est à faire une seule fois.</string>
    <string name="ai_get_steps_title">Ce que vous aurez à faire</string>
    <string name="ai_get_step_open">Appuyez sur le bouton en bas de cet écran : le site de %1$s s\'ouvre dans votre navigateur.</string>
    <string name="ai_get_step_account_free">Connectez-vous, ou créez un compte si vous n\'en avez pas. Aucune carte bancaire n\'est demandée.</string>
    <string name="ai_get_step_account">Connectez-vous, ou créez un compte si vous n\'en avez pas.</string>
    <string name="ai_get_step_create">Cherchez le bouton qui crée une clé d\'API — il est souvent en anglais : « Create API key ».</string>
    <string name="ai_get_step_paste">Copiez la clé, revenez dans Hexavore, et appuyez sur « Coller la clé ».</string>
    <string name="ai_get_step_copy_once">Copiez-la avant de quitter la page : certains fournisseurs ne l\'affichent qu\'une seule fois.</string>
    <string name="ai_get_privacy">La clé restera sur ce téléphone, chiffrée par son trousseau. Les appels partiront en direct chez %1$s : Hexavore n\'a pas de serveur et ne voit rien passer.</string>
    <string name="ai_get_open">Ouvrir le site de %1$s</string>
    <string name="ai_get_back">Revenir</string>

