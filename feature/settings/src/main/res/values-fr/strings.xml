    <string name="ai_configured">Clé enregistrée</string>
    <string name="ai_not_configured">Aucune clé</string>

    <!-- Les quatre fournisseurs ecrits mais pas encore eprouves sur un vrai compte.
         Leur carte reste visible : la cacher laisserait croire qu'ils n'existent pas,
