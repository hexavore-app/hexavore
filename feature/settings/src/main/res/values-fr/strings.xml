    <string name="backup_export_title">Exporter mes données</string>
    <string name="backup_export_body">Un fichier qui contient tout : le journal et ses photos, les objectifs, les pesées, le catalogue et les plats favoris. Vous choisissez où l\'écrire. Ni clé d\'API ni mot de passe n\'y figurent.</string>
    <string name="backup_export_action">Choisir un emplacement</string>
    <string name="backup_exported">Exporté, %1$d Ko</string>
