    <!-- ===== Pastilles ============================================================
         Aucune notification systeme : ce sont des points colorés qu'on voit en ouvrant
         l'application. Chacune designe une situation, jamais un message empile. -->
    <string name="settings_notices_title">Notifications</string>
    <string name="settings_notices_subtitle">Les pastilles qui signalent ce qu\'il y a à faire</string>

    <string name="notices_title">Notifications</string>
    <string name="notices_close">Fermer</string>
    <string name="notices_intro">Des points colorés dans l\'application, rien de plus : aucune sonnerie, rien sur l\'écran de verrouillage, aucune permission. Chacune s\'éteint quand la situation qu\'elle signale a cessé.</string>
    <string name="settings_section_flagged">Quelque chose à régler ici</string>
    <string name="notices_active_now">Allumée en ce moment</string>

    <string name="notices_ai_absent_title">Aucune IA configurée</string>
    <string name="notices_ai_absent_body">Sur l\'icône du profil, tant qu\'aucune clé d\'API ne sert. Les deux boutons d\'analyse restent grisés sans elle.</string>

    <string name="notices_ai_rejected_title">Clé d\'API refusée</string>
    <string name="notices_ai_rejected_body">Sur l\'icône du profil, quand le dernier appel d\'analyse a été refusé. Sans elle, l\'analyse cesse de fonctionner sans que rien ne le dise.</string>

    <string name="notices_weight_title">Pas de pesée depuis une semaine</string>
    <string name="notices_weight_body">Sur l\'icône du journal de poids. Sans pesées régulières, la tendance se tait et l\'adaptation hebdomadaire ne peut rien proposer.</string>

    <string name="notices_yesterday_title">Hier n\'a rien de noté</string>
    <string name="notices_yesterday_body">Sur la pastille d\'hier dans le calendrier. Toucher cette journée permet d\'y noter le repas oublié.</string>

    <!-- ===== Mise au point ========================================================
         Un instrument, pas un reglage : il s\'allume le jour où quelque chose ne va
         pas. Rien n\'est écrit sur le disque, la liste meurt avec le processus. -->
    <!-- L\'analyse approfondie : le modele interroge le catalogue avant de conclure,
         au lieu de laisser un score de ressemblance choisir a sa place. -->
    <string name="ai_deep_title">Analyse approfondie</string>
    <string name="ai_deep_body">Le modèle interroge le catalogue et choisit lui-même la fiche de chaque aliment. Plus lent et plus cher, mais nettement plus juste quand deux aliments portent des noms voisins.</string>
    <string name="ai_deep_unavailable">Le fournisseur actif ne sait pas appeler d\'outils. Le réglage est conservé et reprendra effet avec un fournisseur qui le sait.</string>

    <string name="ai_debug_title">Mode debug</string>
    <string name="ai_debug_body">Garde ce qui part chez le fournisseur et ce qui en revient, pour comprendre une réponse inattendue. Rien n\'est écrit sur le disque, les images sont retirées, et la liste disparaît à la fermeture.</string>
    <string name="ai_debug_open">Voir les échanges</string>

