    <!-- L'écran des fournisseurs. -->
    <string name="ai_title">Intelligence artificielle</string>
    <string name="ai_intro">Vos clés restent sur cet appareil, chiffrées par son trousseau. Les appels partent vers votre fournisseur, sans intermédiaire : Hexavore n\'a pas de serveur.</string>

    <!-- Le compteur d'usage. La date du releve accompagne le montant : docs/05 veut
         que la table de tarifs soit datee et signalee comme indicative, parce qu'une
         estimation perimee presentee comme exacte serait pire que pas d'estimation. -->
    <string name="ai_usage_billing">Hexavore n\'estime aucun coût. Seule la facture de votre fournisseur fait foi.</string>
    <string name="ai_usage_title">Ce que vos analyses ont consommé</string>
