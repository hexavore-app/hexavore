    <!-- The providers screen. -->
    <string name="ai_title">Artificial intelligence</string>
    <!-- Ce que personne ne lit dans un paragraphe : c'est gratuit. La reponse qui
         decide si quelqu'un configure une cle ou referme l'ecran (D138). -->
    <string name="ai_free_title">%1$s is free</string>
    <string name="ai_free_body">A free tier covers everyday use: a few analyses a day cost nothing. You create a key in a few minutes, and no card is asked for.</string>
    <string name="ai_intro">Your keys stay on this device, encrypted by its keystore. Calls go to your provider, with nothing in between: Hexavore has no server.</string>

    <!-- The usage counter. The date of the reading accompanies the amount: docs/05 wants
         the price table dated and flagged as indicative, because an out-of-date estimate
         presented as exact would be worse than no estimate at all. -->
    <string name="ai_usage_billing">Hexavore estimates no cost. Only your provider\'s invoice is authoritative.</string>
    <string name="ai_usage_title">What your analyses have used</string>
    <plurals name="ai_usage_line">
        <item quantity="one">%1$s · %2$s · %3$d call, %4$d tokens</item>
        <item quantity="other">%1$s · %2$s · %3$d calls, %4$d tokens</item>
    </plurals>
    <string name="ai_active">In use</string>
    <string name="ai_configured">Key saved</string>
    <string name="ai_not_configured">No key</string>

