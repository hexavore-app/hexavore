    <!-- The language. First of the four, because it is the one that decides how the three
         others read. -->
    <string name="appearance_language_title">Language</string>
    <string name="appearance_language_system">Follow the system</string>
    <!-- Every language is written in itself, in both files. Someone looking for their own
         language cannot read the one currently on screen — that is exactly why they are
         looking — so "Français" says more than "French" ever could. -->
    <string name="appearance_language_en">English</string>
    <string name="appearance_language_fr">Français</string>
    <string name="appearance_language_note">“Follow the system” takes the languages set on your phone, in their order, and uses the first one Hexavore speaks. English otherwise. Food names follow: the ANSES table publishes its 3,484 labels in both languages.</string>

    <string name="appearance_theme_title">Theme</string>
    <string name="appearance_theme_light">Light</string>
    <string name="appearance_theme_dark">Dark</string>
    <string name="appearance_theme_system">Follow the system</string>
    <string name="appearance_units_title">Units</string>
    <!-- The dish display style. Two styles rather than a density scale: what tells them
         apart is what you read, not a line height. -->
    <string name="appearance_dishes_title">How dishes are shown</string>
    <string name="appearance_dishes_simple">Simple</string>
    <string name="appearance_dishes_detailed">Detailed</string>
    <string name="appearance_dishes_note">Simple gives the dish title, its time, its calories and what it contributes. Detailed adds the list of its foods.</string>

    <string name="appearance_units_metric">Metric (g, ml, kg, cm)</string>
    <string name="appearance_units_imperial">Imperial (oz, fl oz, lb, feet and inches)</string>
    <string name="appearance_units_note">This setting changes what is shown and what you type. Your data does not move: a dish noted in grams keeps its grams.</string>
    <string name="appearance_theme_note">“Follow the system” takes Android\'s setting and switches with it.</string>

    <!-- ===== Notices ==============================================================
         No system notifications: these are coloured dots you see when you open the
         application. Each one designates a situation, never a stacked message. -->
    <string name="settings_notices_title">Notifications</string>
    <string name="settings_notices_subtitle">The dots that flag what there is to do</string>

    <string name="notices_title">Notifications</string>
    <string name="notices_close">Close</string>
    <string name="notices_intro">Coloured dots inside the application, nothing more: no sound, nothing on the lock screen, no permission. Each one goes out when the situation it flags has ended.</string>
    <string name="settings_section_flagged">Something to sort out here</string>
    <string name="notices_active_now">On right now</string>

    <string name="notices_ai_absent_title">No AI configured</string>
    <string name="notices_ai_absent_body">On the profile icon, as long as no API key is in use. Both analysis buttons stay dimmed without one.</string>

    <string name="notices_ai_rejected_title">API key refused</string>
    <string name="notices_ai_rejected_body">On the profile icon, when the last analysis call was refused. Without it, analysis stops working without anything saying so.</string>

    <string name="notices_weight_title">No weight reading for a week</string>
    <string name="notices_weight_body">On the weight log icon. Without regular readings, the trend falls silent and the weekly adjustment can suggest nothing.</string>

    <string name="notices_yesterday_title">Yesterday has nothing noted</string>
    <string name="notices_yesterday_body">On yesterday\'s dot in the calendar. Touching that day lets you note the meal you forgot.</string>

    <!-- ===== Diagnostics ==========================================================
         An instrument, not a setting: it is switched on the day something goes wrong.
         Nothing is written to disk, the list dies with the process. -->
    <!-- Deep analysis: the model queries the catalogue before concluding, instead of
         letting a similarity score choose in its place. -->
    <string name="ai_deep_title">Deep analysis</string>
    <string name="ai_deep_body">The model queries the catalogue and picks the entry for each food itself. It is always on where the provider can call tools: without it, foods the catalogue does not match come back with no values at all.</string>
    <string name="ai_deep_unavailable">The active provider cannot call tools. Foods it does not match will be estimated instead, and flagged as estimates.</string>

    <string name="ai_debug_title">Debug mode</string>
    <string name="ai_debug_body">Keeps what goes to the provider and what comes back, to make sense of an unexpected answer. Nothing is written to disk, images are stripped out, and the list disappears when you close it.</string>
    <string name="ai_debug_open">See the exchanges</string>

