    <!-- L’aide à la clé : trois questions qu’on se pose toutes en même temps. -->
    <string name="ai_key_help_link">Comment obtenir une clé ?</string>
    <string name="ai_key_help_title">Une clé %1$s</string>
    <string name="ai_key_help_what">Une clé d\'API est un mot de passe que vous créez chez le fournisseur. Elle autorise Hexavore à lui envoyer vos photos et vos descriptions de repas pour analyse.</string>
    <string name="ai_key_help_where">Le bouton ci-dessous ouvre la page de %1$s où l\'on crée une clé. Copiez-la, puis revenez la coller ici.</string>
    <string name="ai_key_help_billing">La clé reste sur cet appareil, chiffrée par son trousseau. Les appels partent en direct, et c\'est votre fournisseur qui les compte et les facture.</string>
    <string name="ai_key_help_open">Ouvrir la page</string>
    <string name="ai_key_help_close">Fermer</string>
    <string name="ai_forget">Effacer la clé</string>

    <!-- Ce que l'essai apprend. Il coûte un appel : son résultat reste affiché. -->
    <string name="ai_probe_ok_vision">Clé valide. Photo et texte sont disponibles.</string>
    <string name="ai_probe_ok_text_only">Clé valide. Ce modèle ne lit pas les images : seul le mode texte fonctionnera.</string>

