    <string name="appearance_language_en">English</string>
    <string name="appearance_language_fr">Français</string>
    <string name="appearance_language_note">“Follow the system” uses the first language on your phone that Hexavore speaks, otherwise English. Food names follow: the ANSES table comes in both languages.</string>

    <string name="appearance_theme_title">Theme</string>
    <string name="appearance_theme_light">Light</string>
    <string name="appearance_theme_dark">Dark</string>
    <string name="appearance_theme_system">Follow the system</string>
    <string name="appearance_units_title">Units</string>
    <!-- The dish display style. Two styles rather than a density scale: what tells them
         apart is what you read, not a line height. -->
    <string name="appearance_dishes_title">How meals are shown</string>
    <string name="appearance_dishes_simple">Simple</string>
    <string name="appearance_dishes_detailed">Detailed</string>
    <string name="appearance_dishes_note">Simple: the meal\'s title, time, calories and nutrients. Detailed: the list of foods too.</string>

    <string name="appearance_units_metric">Metric (g, ml, kg, cm)</string>
    <string name="appearance_units_imperial">Imperial (oz, fl oz, lb, feet and inches)</string>
    <string name="appearance_units_note">Changes what you see and type. Your data doesn\'t move: a meal logged in grams stays in grams.</string>
    <string name="appearance_theme_note">“Follow the system” follows Android\'s setting.</string>

    <!-- ===== Notices ==============================================================
         No system notifications: these are coloured dots you see when you open the
         application. Each one designates a situation, never a stacked message. -->
    <string name="settings_notices_title">Notifications</string>
    <string name="settings_notices_subtitle">The dots that flag something for you</string>

    <string name="notices_title">Notifications</string>
    <string name="notices_close">Close</string>
    <!-- The dots, and the dots alone (D162): the screen also holds the reminders, which
         ring and need a permission, and the sentence seemed to speak of them. -->
    <string name="notices_intro">Dots are just coloured marks in the app: no sound, nothing on the lock screen, no permission. Each one goes away once the issue is sorted. Only the reminders, further down, ring outside the app.</string>
    <string name="settings_section_flagged">Something to sort out here</string>
    <string name="notices_active_now">On right now</string>

    <string name="notices_ai_absent_title">No AI set up</string>
    <!-- The bar is no longer dimmed without a key: it turns red and says what is missing (D162). -->
    <string name="notices_ai_absent_body">On the profile icon, as long as there\'s no key. Without one, the analysis bar turns red and says what\'s missing.</string>

    <string name="notices_ai_rejected_title">AI key rejected</string>
    <string name="notices_ai_rejected_body">On the profile icon, when the last analysis was rejected. Otherwise analysis would stop working without a word.</string>

    <string name="notices_weight_title">No weigh-in for a week</string>
    <!-- The trend no longer falls silent since D159: it is the adjustment that lacks ground (D162). -->
    <string name="notices_weight_body">On the weight icon. Without regular weigh-ins, the weekly adjustment has nothing to go on.</string>

    <string name="notices_yesterday_title">Nothing logged yesterday</string>
    <string name="notices_yesterday_body">On yesterday\'s dot in the calendar. Tap that day to add the meal you forgot.</string>
    <!-- The way back from "Don't show tips again" (D179). -->
    <string name="notices_tips_title">Tips when the app opens</string>
    <string name="notices_tips_body">Now and then, when you open the app, a tip you might not guess. Each one once, never two at a time.</string>

    <!-- Deep analysis: the model queries the catalogue before concluding, instead of
         letting a similarity score choose in its place. -->
    <string name="ai_deep_title">Deep analysis</string>
    <string name="ai_deep_body">The model digs through the catalogue and picks each food itself. Always on when the provider can use tools: without it, foods that aren\'t found would come back with no values.</string>
    <string name="ai_deep_unavailable">This provider can\'t use tools. Foods it doesn\'t find will be estimated, and marked as estimates.</string>

    <!-- Les rappels : la seconde moitie de cet ecran. Ils sonnent dehors, la ou les
         pastilles se voient en ouvrant l'application. -->
    <string name="reminders_title">Reminders</string>
    <string name="reminders_intro">These do ring, outside the app. Each stays quiet if there\'s nothing to say: no lunch reminder if lunch is already logged.</string>
    <string name="reminders_blocked">Android is blocking Hexavore\'s notifications. Reminders are set, but nothing will ring.</string>
    <string name="reminders_allow">Allow notifications</string>
    <string name="reminders_breakfast_title">Breakfast</string>
    <string name="reminders_lunch_title">Lunch</string>
    <string name="reminders_dinner_title">Dinner</string>
    <string name="reminders_streak_title">Streak at stake</string>
    <string name="reminders_meal_body">Quiet once this meal is logged.</string>
