    <!-- Help with the key: three questions you ask yourself all at once. -->
    <string name="ai_key_help_link">How do I get a key?</string>
    <string name="ai_key_help_title">A %1$s key</string>
    <string name="ai_key_help_what">An API key is a password you create at the provider. It lets Hexavore send them your photos and your meal descriptions for analysis.</string>
    <string name="ai_key_help_where">The button below opens the %1$s page where a key is created. Copy it, then come back and paste it here.</string>
    <string name="ai_key_help_billing">The key stays on this device, encrypted by its keystore. Calls go out directly, and it is your provider who counts and bills them.</string>
    <string name="ai_key_help_open">Open the page</string>
    <string name="ai_key_help_close">Close</string>
    <string name="ai_forget">Erase the key</string>

    <!-- What the test teaches. It costs one call: its result stays on screen. -->
    <string name="ai_probe_ok_vision">Key valid. Photo and text are both available.</string>
    <string name="ai_probe_ok_text_only">Key valid. This model does not read images: only text mode will work.</string>

    <!-- An HTTP code never reaches the screen: every outcome has its message, and most
         have an action. -->

    <!-- ===== Backup ================================================================
         The project\'s guarantee of reversibility: an open format, an export that works,
         and an erase that keeps its promise (docs/09). -->
    <string name="settings_backup_title">Backup</string>
    <string name="settings_backup_subtitle">Export your data, restore it, or erase everything</string>

    <string name="backup_title">Backup</string>
    <string name="backup_close">Close</string>
    <string name="backup_cancel">Cancel</string>

    <string name="backup_export_title">Export my data</string>
    <string name="backup_export_body">A file containing everything: the log, the targets, the weight readings, the catalogue and the favourite dishes. You choose where to write it. Neither API keys nor passwords are in it.</string>
    <string name="backup_export_action">Choose a location</string>
    <string name="backup_exported">Exported, %1$d kB</string>
    <!-- Past the megabyte: an archive carrying photos is counted in MB, and "214,072 kB"
         does not read. -->
    <string name="backup_exported_large">Exported, %1$.1f MB</string>
    <string name="backup_export_failed">The file could not be written</string>

    <string name="backup_import_title">Restore a backup</string>
    <string name="backup_import_body">Replaces everything on this device with the contents of the file. A copy of what exists is kept just beforehand.</string>
    <string name="backup_import_action">Choose a file</string>
    <string name="backup_restore_confirm_title">Replace all your data?</string>
    <string name="backup_restore_confirm_body">The contents of the file will replace everything on this device. The two will not be merged. A copy of the current state is kept just beforehand, so you can go back if you picked the wrong file.</string>
    <string name="backup_restore_confirm_accept">Choose a file</string>
    <string name="backup_restored">Restored, %1$d foods noted</string>
    <string name="backup_too_recent">This file comes from a more recent version (format %1$d). Nothing was changed: update the application.</string>
    <string name="backup_unreadable">File unreadable. Nothing was changed.</string>
    <string name="backup_restore_failed">The restore failed. A copy of your data from before is on the device.</string>

    <string name="backup_erase_title">Erase all my data</string>
    <string name="backup_erase_body">Deletes the log, the profile, the targets, the weight readings, the API keys and the accounts. Files you have already exported are untouched.</string>
    <string name="backup_erase_action">Erase everything</string>
    <string name="backup_erase_confirm_title">Erase everything, with no way back?</string>
    <string name="backup_erase_confirm_body">This action cannot be undone. To confirm, type %1$s below.</string>
    <string name="backup_erase_confirm_accept">Erase everything</string>
    <!-- The word to type, and it is translated on purpose: a lock that asks you to read
         only locks in a language you read. The comparison is made against this resource,
         so it follows the translation on its own. -->
    <string name="backup_erase_word">DELETE</string>
    <string name="backup_erased">All your data has been erased</string>

