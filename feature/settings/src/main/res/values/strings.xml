    <!-- The providers screen. -->
    <string name="ai_title">AI</string>
    <!-- Ce que personne ne lit dans un paragraphe : c'est gratuit. La reponse qui
         decide si quelqu'un configure une cle ou referme l'ecran (D138). -->
    <string name="ai_free_title">%1$s is free</string>
    <!-- In everyday words (D178): "tier" and "everyday use" did not say that a day's meals
         fit in it with room to spare. -->
    <string name="ai_free_body">An account is all you need, and the free tier easily covers a day of meals. No subscription, no card. The key (a personal code to paste here) takes two minutes to get, once.</string>
    <!-- What a key is, before saying where it stays (D178). -->
    <string name="ai_intro">A key is a personal code linking Hexavore to your account with an AI provider. It stays encrypted on your phone, and requests go straight to the provider: Hexavore has no server.</string>

    <!-- The usage counter. The date of the reading accompanies the amount: docs/05 wants
         the price table dated and flagged as indicative, because an out-of-date estimate
         presented as exact would be worse than no estimate at all. -->
    <string name="ai_usage_billing">Hexavore doesn\'t estimate costs. Only your provider\'s bill counts.</string>
    <string name="ai_usage_title">What your analyses used</string>
    <plurals name="ai_usage_line">
        <item quantity="one">%1$s · %2$s · %3$d call, %4$d tokens</item>
        <item quantity="other">%1$s · %2$s · %3$d calls, %4$d tokens</item>
    </plurals>
    <string name="ai_active">In use</string>
    <string name="ai_configured">Key saved</string>
    <string name="ai_not_configured">No key</string>

    <!-- The four providers that are written but not yet tried on a real account. Their
         card stays visible: hiding it would suggest they do not exist, and offering them
         would make someone pay to discover a flaw nobody has looked for. -->
    <string name="ai_provider_soon">Coming soon</string>
    <string name="ai_provider_recommended">Recommended</string>
    <string name="ai_key_label">API key</string>
    <string name="ai_model_label">Model</string>
    <string name="ai_base_url_label">Base URL</string>
    <string name="ai_reveal">Show the key</string>
    <string name="ai_hide">Hide the key</string>
    <!-- One gesture where there were two: validating tests, then saves, and stops at the
         first refusal (D156). "Test" and "Erase the key" are gone. -->
    <string name="ai_validate">Validate the key</string>
    <string name="ai_validating">Checking…</string>
    <string name="ai_in_use">In use</string>
    <string name="ai_advanced">Advanced settings</string>

    <!-- The button that opens the retrieval screen. The one wall every tester stopped at
         was a small underlined link (D156). -->
    <string name="ai_key_get">Get the key</string>

    <!-- Pasting takes a long press then a system bubble to aim at, on a field masked by
         dots: the gesture testers miss on their way back from the browser. A button
         reduces it to one tap (D157). -->
    <string name="ai_key_paste">Paste the key</string>
    <string name="ai_key_paste_empty">Nothing to paste. Copy the key on the site first, then come back.</string>

    <!-- ===== Getting a key =========================================================
         A screen, not a discreet link: it announces that you are leaving the app, says
         nobody can do this step for you, and that it is done only once (D156). The steps
         are short and depend on no exact label: consoles change shape several times a
         year. -->
    <string name="ai_get_title">Get a key</string>
    <string name="ai_get_close">Close</string>
    <string name="ai_get_warning_title">You\'re about to leave Hexavore</string>
    <string name="ai_get_warning_body">The key is created on the %1$s site. Nobody can do it for you: you need an account in your name, and %1$s gives you the key.</string>
    <string name="ai_get_warning_once">Two minutes, and only once.</string>
    <string name="ai_get_steps_title">What you\'ll do</string>
    <string name="ai_get_step_open">Tap the button below: the %1$s site opens in your browser.</string>
    <string name="ai_get_step_account_free">Sign in, or create an account. No card needed.</string>
    <string name="ai_get_step_account">Sign in, or create an account.</string>
    <string name="ai_get_step_create">Look for the button that creates a key, usually “Create API key”.</string>
    <string name="ai_get_step_paste">Copy the key, come back to Hexavore and tap “Paste the key”.</string>
    <string name="ai_get_step_copy_once">Copy it before leaving the page: some providers only show it once.</string>
    <string name="ai_get_privacy">The key stays encrypted on your phone. Requests go straight to %1$s: Hexavore has no server and sees nothing.</string>
    <string name="ai_get_open">Open the %1$s site</string>
    <string name="ai_get_back">Go back</string>

    <!-- An HTTP code never reaches the screen: every outcome has its message, and most
         have an action. -->

    <!-- ===== Backup ================================================================
         The project\'s guarantee of reversibility: an open format, an export that works,
         and an erase that keeps its promise (docs/09). -->
    <string name="settings_backup_title">Backup</string>
    <string name="settings_backup_subtitle">Export, restore or erase everything</string>

    <string name="backup_title">Backup</string>
    <string name="backup_close">Close</string>
    <string name="backup_cancel">Cancel</string>

    <string name="backup_export_title">Export my data</string>
    <string name="backup_export_body">One file with everything: your log and its photos, targets, weigh-ins, catalogue and favourites. You pick where it goes. No keys or passwords inside.</string>
    <string name="backup_export_action">Choose a location</string>
    <string name="backup_exported">Exported, %1$d kB</string>
    <!-- Past the megabyte: an archive carrying photos is counted in MB, and "214,072 kB"
         does not read. -->
    <string name="backup_exported_large">Exported, %1$.1f MB</string>
    <string name="backup_export_failed">Couldn\'t write the file</string>

    <string name="backup_import_title">Restore a backup</string>
    <string name="backup_import_body">Replaces everything on this phone with what\'s in the file. We keep a copy just before, just in case.</string>
    <string name="backup_import_action">Choose a file</string>
    <string name="backup_restore_confirm_title">Replace all your data?</string>
    <string name="backup_restore_confirm_body">The file replaces everything on this phone, no merging. We keep a copy just before: if you picked the wrong file, you can go back from this screen.</string>
    <string name="backup_restore_confirm_accept">Choose a file</string>
    <!-- Plurals: a backup holding a single food read "1 foods noted" (D162). -->
    <plurals name="backup_restored">
        <item quantity="one">Restored, %1$d food noted</item>
        <item quantity="other">Restored, %1$d foods noted</item>
    </plurals>
    <string name="backup_too_recent">This file is from a newer version (format %1$d). Nothing changed: update the app.</string>
    <string name="backup_unreadable">Can\'t read this file. Nothing changed.</string>
    <string name="backup_restore_failed">The restore failed. A copy of your previous data is on the phone.</string>

    <!-- Going back to the safety copy (D162): the restore dialog promised it, and no
         screen offered it. The card only shows after a restore, which leaves the copy. -->
    <string name="backup_undo_title">Go back</string>
    <string name="backup_undo_body">Puts your log back as it was before the %1$s restore. Photos only come back if the app hasn\'t been restarted since.</string>
    <string name="backup_undo_action">Go back</string>
    <string name="backup_undo_confirm_title">Go back to before?</string>
    <string name="backup_undo_confirm_body">Your current log gets replaced by the one from before the last restore. It then becomes the backup copy, so you can undo this the same way.</string>
    <plurals name="backup_undone">
        <item quantity="one">Back to the earlier state, %1$d food noted</item>
        <item quantity="other">Back to the earlier state, %1$d foods noted</item>
    </plurals>

    <string name="backup_erase_title">Erase all my data</string>
    <!-- The copy kept before a restore is named (D162): it survived the erase, and the
         whole log stayed on the phone. -->
    <string name="backup_erase_body">Deletes your log, photos, profile, targets, weigh-ins, keys and accounts, plus the copy kept before the last restore. Files you already exported stay put.</string>
    <string name="backup_erase_action">Erase everything</string>
    <string name="backup_erase_confirm_title">Erase everything for good?</string>
    <string name="backup_erase_confirm_body">There\'s no undo. To confirm, type %1$s below.</string>
    <string name="backup_erase_confirm_accept">Erase everything</string>
    <!-- The word to type, and it is translated on purpose: a lock that asks you to read
         only locks in a language you read. The comparison is made against this resource,
         so it follows the translation on its own. -->
    <string name="backup_erase_word">DELETE</string>
    <string name="backup_erased">Everything\'s been erased</string>

