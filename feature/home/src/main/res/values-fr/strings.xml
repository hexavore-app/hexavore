<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="fr">

    <string name="home_title">Aujourd\'hui</string>
    <!-- Les deux jours qui ont un nom le portent : « Hier » se lit plus vite qu\'une
         date qu\'il faut décoder. Au-delà, la date longue reprend la main. -->
    <string name="home_title_yesterday">Hier</string>
    <string name="home_title_before_yesterday">Avant-hier</string>

    <!-- Le chemin visible du retour à aujourd'hui. Le bouton retour du système y mène
         aussi, mais un geste sans représentation visible est introuvable pour qui
         l'ignore — la même règle que le balayage qui supprime une ligne. -->
    <string name="home_back_to_today">Aujourd\'hui</string>

    <!-- Le chiffre affiché est le restant, pas le consommé : c'est l'information
         dont on a besoin au moment de décider quoi manger. -->
    <string name="home_remaining_label">kcal restantes</string>
    <string name="home_over_label">kcal de trop</string>
    <!-- Un pluriel : au premier gramme de la journée, « 1 consommées sur 2 127 » (D162). -->
    <plurals name="home_consumed_of_goal">
        <item quantity="one">%1$d consommée sur %2$d</item>
        <item quantity="other">%1$d consommées sur %2$d</item>
    </plurals>
    <string name="home_ring_a11y">Calories, %1$d sur %2$d, %3$d %%</string>

    <!-- Une liste vide dit quoi faire, pas seulement qu'elle est vide. -->
    <string name="home_empty_title">Rien de noté aujourd\'hui</string>
    <string name="home_empty_body">Les six compteurs se rempliront à la première saisie.</string>
    <!-- Le même vide, sur un jour passé (D162) : il se dit au passé, et ce qu'on peut y
         faire est rattraper un oubli, pas remplir des compteurs. -->
    <string name="home_empty_past_title">Rien de noté ce jour-là</string>
    <string name="home_empty_past_body">Un repas oublié peut encore y être noté : il sera rangé à cette date.</string>

    <!-- Un échec de lecture se dit, il ne s'affiche pas comme une journée vide :
         une journée vide est une affirmation, pas une absence de réponse. -->
    <string name="home_error_title">Journal illisible</string>
    <string name="home_error_body">La lecture n\'a pas abouti. Rien n\'a été modifié : vos plats sont là où ils étaient.</string>
    <string name="home_error_retry">Réessayer</string>

    <!-- Tant qu'aucun objectif n'a été posé. Une invitation, pas six jauges vides :
         une jauge à zéro laisserait croire qu'un objectif existe et n'est pas atteint. -->
    <string name="home_no_goal_title">Pas encore d\'objectif</string>
    <string name="home_no_goal_body">Cinq questions suffisent à calculer vos six objectifs. En attendant, vos totaux sont notés sans être comparés à rien.</string>
    <string name="home_no_goal_action">Définir mon objectif</string>

    <!-- Une journée antérieure au premier objectif, quand un objectif court aujourd'hui
         (D161). Une explication, sans bouton : l'invitation ci-dessus relançait
         l'onboarding chez quelqu'un qui venait d'y répondre et revenait noter un repas
         d'avant son installation. -->
    <string name="home_before_goal_title">Avant votre objectif</string>
    <string name="home_before_goal_body">Cette journée précède votre premier objectif : ses totaux sont notés, sans être comparés à rien.</string>

    <!-- Une icône seule : c'est la porte la moins fréquentée de l'écran, et rien ne
         doit disputer au titre du jour la première ligne du regard. -->
    <string name="home_open_profile">Profil et objectifs</string>
    <string name="home_open_weight">Journal de poids</string>

    <!-- Ce qui a été mangé reste exact sans objectif : c'est la comparaison qui manque.
         Plus de forme « au moins » : l'accueil ne signale plus les totaux minorés, et
         une valeur non renseignée s'y lit comme zéro (D119). -->
    <string name="home_total_line">%1$s : %2$d</string>

    <!-- Aucune suppression n'est immédiatement définitive. La barre parle du plat :
         c'est la seule chose que l'accueil supprime depuis que le balayage sert à
         changer de jour, et son libellé annonçait une ligne même pour un plat entier. -->
    <string name="home_dish_deleted">Plat supprimé</string>
    <string name="home_dish_undo">Annuler</string>

    <!-- Une ligne est un seul nœud d'accessibilité : nom, quantité, calories, en
         une phrase plutôt qu'en trois arrêts. -->
    <plurals name="home_entry_a11y">
        <item quantity="one">%1$s, %2$s %3$s, %4$d kilocalorie</item>
        <item quantity="other">%1$s, %2$s %3$s, %4$d kilocalories</item>
    </plurals>

    <!-- Un plat : plusieurs aliments entrés en une fois, situés par leur heure. -->
    <string name="home_dish_kcal">%1$d kcal</string>
    <!-- Le plat entier est tapable. Ce libellé est ce que TalkBack annonce après
         « appuyer deux fois pour » : sans lui, il dirait « activer ». -->
    <string name="home_dish_edit">modifier ce plat</string>

    <!-- L'appui long double le tap plutôt que de le remplacer : le tap ouvre la
         modification, le menu donne accès à ce qui n'a pas sa place sur le plat. -->
    <string name="home_dish_menu">ouvrir le menu du plat</string>
    <string name="home_dish_menu_edit">Modifier</string>
    <!-- Le geste qui manquait a l'appui long : il existait sur l'ecran de saisie
         seulement (D157). -->
    <string name="home_dish_menu_copy">Copier sur un autre jour</string>
    <string name="home_dish_copied_to">Plat copié au %1$s</string>
    <string name="home_dish_menu_delete">Supprimer</string>
    <string name="home_dish_menu_favorite">Mettre en favori</string>
    <string name="home_dish_menu_unfavorite">Retirer des favoris</string>

    <!-- Les trois autres façons d'ajouter, sous le « + ». Chacune porte son nom et une
         ligne qui dit ce qu'elle ouvre : un glyphe seul se reconnaît, jamais ne
         s'explique. -->
    <string name="home_open_favorites">Favoris</string>
    <string name="home_open_favorites_hint">Rejouer un plat enregistré</string>
    <string name="home_scan">Scanner</string>
    <string name="home_scan_hint">Un code-barres, et la fiche du produit avec</string>
    <string name="home_add_by_hand">Ajouter à la main</string>
    <string name="home_add_by_hand_hint">Chercher dans le catalogue, ou créer la fiche soi-même</string>
    <string name="home_more_ways">Autres façons d\'ajouter</string>

    <!-- La barre du bas. Écrire ce qu'on a mangé est le geste le plus fréquent de
         l'application : c'est donc la barre elle-même, et non un bouton qui ouvre un
         écran. -->
    <string name="home_describe_label">Qu\'avez-vous mangé ?</string>
    <!-- Ce qui manque, dit comme une invitation : l'IA est gratuite, il reste à
         l'activer (D178). « Configurez » parlait à qui sait déjà ce qu'on configure. -->
    <string name="home_describe_locked">Activez l\'IA gratuite pour décrire vos repas</string>
    <string name="home_send_description">Analyser ce repas</string>
    <string name="home_shoot">Photographier le repas</string>
    <string name="home_analysing">Analyse en cours…</string>
    <string name="home_analysing_busy">Service saturé, nouvelle tentative…</string>
    <!-- La même phrase que l'écran d'IA : l'estimation s'attendait derrière un écran
         noir (D176). -->
    <string name="home_analysing_estimating">Estimation des valeurs nutritionnelles…</string>
    <string name="home_analyse_cancel">Annuler</string>
    <!-- Un fournisseur en panne ne doit jamais empêcher de noter son repas. -->
    <string name="home_analyse_manual">Ajouter à la main</string>

    <!-- Sans cle, le champ et l'appareil photo restent visibles et expliquent a l'appui :
         caches, ils ne s'apprennent jamais ; inertes, ils n'apprennent rien non plus
         (D73). Le grise ne se voit pas au lecteur d'ecran, d'ou cette phrase. -->
    <string name="home_analyse_unavailable">indisponible, aucune clé d\'IA</string>

    <!-- Ce qui manque, ce que ça coûte, et où aller, en mots de tous les jours (D178) :
         pourquoi l'IA passe par son propre compte, ce qu'est une clé, et que c'est
         gratuit. L'ancienne phrase parlait de fournisseur et de facturation à quelqu'un
         qui ne sait pas ce qu'est une clé d'API. Le bouton ouvre le guide de la clé
         Gemini, posé sur la section d'IA : on y revient pour la coller. -->
    <string name="home_ai_title">Activez l\'IA, gratuitement</string>
    <string name="home_ai_explanation">Hexavore est gratuite et n\'a pas de serveur : pour lire vos photos et vos phrases, elle s\'appuie sur Gemini, l\'IA de Google, avec votre propre compte Google.\n\nIl vous suffit d\'y récupérer une clé, un code personnel qui ouvre cet accès, puis de la coller ici. C\'est gratuit, sans abonnement ni carte bancaire, et cela prend deux minutes, une seule fois.</string>
    <string name="home_ai_configure">Obtenir ma clé</string>
    <string name="home_ai_later">Plus tard</string>

    <!-- Le nom est proposé depuis les aliments du plat, puis librement réécrit : un
         favori sans nom serait introuvable, et un champ vide ferait renoncer. -->
    <string name="home_favorite_title">Enregistrer comme favori</string>
    <string name="home_favorite_body">Vous le retrouverez sous ce nom, prêt à rejouer. Modifier une ligne l\'en retirera.</string>
    <string name="home_favorite_name">Nom du plat</string>
    <string name="home_favorite_name_taken">Un plat en favori porte déjà ce nom.</string>
    <string name="home_favorite_confirm">Enregistrer</string>
    <string name="home_favorite_cancel">Annuler</string>

    <!-- Un dialogue, là où le balayage d'une ligne se contente de sa barre : celui-ci
         emporte n lignes d'un coup, et le nombre est dit. -->
    <string name="home_dish_delete_title">Supprimer ce plat ?</string>
    <!-- Le nombre figure dans les deux formes : en français, « one » couvre aussi
         zéro, et un message sans son chiffre y deviendrait faux. -->
    <plurals name="home_dish_delete_body">
        <item quantity="one">%1$d ligne sera retirée de votre journée. Vous pourrez annuler juste après.</item>
        <item quantity="other">%1$d lignes seront retirées de votre journée. Vous pourrez annuler juste après.</item>
    </plurals>
    <string name="home_dish_delete_confirm">Supprimer</string>
    <string name="home_dish_delete_cancel">Annuler</string>
    <string name="home_entry_quantity">%1$s %2$s</string>
    <string name="home_entry_kcal">%1$d kcal</string>

    <!-- Apports du plat. L'initiale porte la même information que la couleur :
         une couleur ne renseigne jamais seule. -->
    <string name="home_macro_chip">%1$s %2$s</string>
    <string name="home_macro_grams">%1$s g</string>

    <string name="macro_calories">Calories</string>
    <string name="macro_protein">Protéines</string>
    <string name="macro_carbs">Glucides</string>
    <string name="macro_sugars">Sucres</string>
    <string name="macro_fat">Lipides</string>
    <string name="macro_fiber">Fibres</string>

    <!-- La bulle des sources d\'une macro : ce qui la lui a donnée, du plus gros au
         plus petit. « Valeur inconnue » n\'est pas « zéro » — c\'est la seule ligne de
         l\'accueil qui dise encore qu\'un total est minoré, et la seule qui dise par
         quel aliment. -->
    <string name="home_sources_of_goal">%1$s sur %2$s</string>
    <string name="home_sources_unknown">Valeur inconnue : %1$s</string>
    <string name="home_sources_open">Afficher les sources</string>
    <string name="home_sources_action">Afficher les sources : %1$s</string>
    <plurals name="home_sources_others">
        <item quantity="one">%1$d autre</item>
        <item quantity="other">%1$d autres</item>
    </plurals>

    <!-- Les initiales des pastilles vivent dans le design system depuis D162 :
         l'hexagone lit les mêmes, et avait les siennes, en français. -->

    <!-- Le bandeau calendrier et la vue mensuelle. Une journée sans saisie est
         annoncée comme telle : pour un lecteur d'écran, un anneau absent ne se
         distingue pas d'un anneau vide, alors que la différence est tout le sujet. -->
    <string name="calendar_day_a11y">Le %1$d, journée notée</string>
    <string name="calendar_day_empty_a11y">Le %1$d, aucune saisie</string>
    <!-- Un jour à venir : il se voit mais ne s'ouvre pas. Le dire évite de chercher
         pourquoi le toucher ne fait rien. -->
    <string name="calendar_day_future_a11y">Le %1$d, jour à venir</string>
    <string name="calendar_close">Fermer</string>
    <!-- La poignée. Elle porte le geste d'ouverture parce qu'un glissement vertical
         sur le mois déplié appartient à son propre défilement. -->
    <string name="calendar_expand">Afficher le mois</string>
    <string name="calendar_collapse">Revenir à la semaine</string>

    <!-- ===== Pastilles ============================================================
         Chacune designe une situation, jamais un message : elle s'eteint quand la
         situation cesse, et aucune ne se rejette. Le libelle dit ce qu'il y a a faire,
         jamais « notification » - « 1 notification » demande d'aller voir. -->
    <string name="notice_ai_absent">Aucune intelligence artificielle configurée</string>
    <string name="notice_ai_rejected">Votre clé d\'API a été refusée</string>
    <string name="notice_weight_stale">Aucune pesée depuis une semaine</string>
    <string name="notice_yesterday_empty">Hier n\'a rien de noté</string>

    <!-- La progression, en trois choses sur une ligne. L’ecran qui la deplie est a un
         tap : l’accueil repond deja a une question, et deux en pleine page rendraient
         la premiere moins nette. -->
    <plurals name="home_streak_days">
        <item quantity="one">%1$d jour</item>
        <item quantity="other">%1$d jours</item>
    </plurals>
    <string name="home_level">Niveau %1$d</string>
    <string name="home_open_progress">Votre progression</string>
    <string name="home_level_a11y">Niveau %1$d, %2$s de suite. Ouvrir votre progression.</string>

    <!-- Ce qui passe a l’ecran quand un palier tombe. Rien a fermer : l’animation
         passe, et on continue a noter dessous. -->
    <string name="home_celebration_title">Palier atteint</string>
    <!-- Des pluriels et non des chaînes : le premier palier doré tombe à un jour, et
         s'annonçait « 1 journées dorées d'affilée » (D162). -->
    <plurals name="home_badge_streak">
        <item quantity="one">%1$d jour</item>
        <item quantity="other">%1$d jours d\'affilée</item>
    </plurals>
    <plurals name="home_badge_volume">
        <item quantity="one">%1$d plat noté</item>
        <item quantity="other">%1$d plats notés</item>
    </plurals>
    <plurals name="home_badge_perfect">
        <item quantity="one">%1$d journée dorée</item>
        <item quantity="other">%1$d journées dorées d\'affilée</item>
    </plurals>
    <string name="home_badge_first_scan">Premier scan</string>
    <string name="home_badge_first_photo">Première photo</string>
    <string name="home_badge_first_text">Première description</string>
    <string name="home_badge_first_favorite">Premier favori</string>
    <!-- Au lancement qui suit un plantage : sur le moment, la pile se deroule et
         une boite ouverte depuis un gestionnaire d'exception ne marche qu'une fois
         sur deux (D138). -->
    <string name="crash_title">Hexavore s\'est fermé seul</string>
    <string name="crash_body">Une trace technique a été gardée. Elle ne contient ni vos repas, ni votre poids, ni votre clé : des noms de classes et des numéros de ligne. Vous pourrez la relire avant de l\'envoyer.</string>
    <string name="crash_send">Envoyer le rapport</string>
    <string name="crash_decline">Non merci</string>
    <string name="crash_subject">Hexavore s\'est fermé seul</string>
    <string name="crash_intro">Voici la trace du dernier plantage.</string>
    <!-- Le tour guide du premier lancement (D141). -->
    <string name="tour_day_title">Votre journée d\'un coup d\'œil</string>
    <string name="tour_day_body">L\'hexagone se remplit à mesure que vous notez, et les six compteurs disent ce qu\'il reste. Ces repas sont un exemple : ils disparaîtront à la fin du tour.</string>
    <string name="tour_describe_title">Dites-le avec vos mots</string>
    <string name="tour_describe_body">« Porridge au lait avec une banane ». L\'IA lit la phrase, trouve les aliments et les pèse. Vous vérifiez, vous corrigez, vous enregistrez.</string>
    <string name="tour_photo_title">Ou photographiez l\'assiette</string>
    <string name="tour_photo_body">Une prise, et vous pouvez ajouter un mot si l\'image est ambiguë. Ce que vous écrivez l\'emporte sur ce qui est vu.</string>
    <string name="tour_more_title">Et quand vous préférez être exact</string>
    <string name="tour_more_body">Un code-barres, le catalogue de 3 484 aliments hors ligne, ou un plat que vous avez gardé. Ces trois-là ne demandent jamais de clé.</string>
    <!-- La première fois qu'on parle de clé, et la plus importante (D178) : pourquoi un
         compte, ce qu'est une clé, ce que ça coûte. -->
    <string name="tour_ai_title">Une IA gratuite, avec votre compte Google</string>
    <string name="tour_ai_body">Hexavore n\'a ni serveur ni abonnement : pour la phrase et la photo, elle s\'appuie sur Gemini, l\'IA de Google, avec votre propre compte. Il suffit d\'y récupérer une clé, un code personnel à coller ici : c\'est gratuit, sans carte bancaire, et cela prend deux minutes, une seule fois.</string>
    <string name="tour_degraded_title">Sans clé, il manque deux gestes</string>
    <string name="tour_degraded_body">Le champ et l\'appareil photo restent en rouge : tout le reste fonctionne, et vous pourrez poser une clé quand vous voudrez depuis les réglages. Rien n\'est perdu entre-temps.</string>
    <string name="tour_next">Suivant</string>
    <string name="tour_skip">Passer</string>
    <string name="tour_done">J\'ai compris</string>
    <string name="tour_later">Plus tard</string>
    <string name="tour_configure">Obtenir ma clé</string>
    <string name="tour_calories_title">Calories : le triangle du haut</string>
    <string name="tour_calories_body">Le sommet de l\'hexagone, et le grand chiffre juste en dessous : ce qu\'il vous reste d\'énergie pour la journée. Le triangle grandit à mesure que vous mangez, et déborde du contour si vous dépassez.</string>
    <string name="tour_protein_title">Protéines : à droite du sommet</string>
    <string name="tour_protein_body">Ce qui construit et répare le muscle. Un objectif à atteindre, pas un plafond : ce triangle-là, on cherche à le remplir jusqu\'au bord.</string>
    <string name="tour_carbs_title">Glucides : le triangle du bas</string>
    <string name="tour_carbs_body">Le carburant principal : pain, pâtes, riz, fruits. C\'est un plafond, donc un triangle qui dépasse le contour est un signal, pas une réussite.</string>
    <string name="tour_sugars_title">Sucres : en bas à gauche</string>
    <string name="tour_sugars_body">La part des glucides qui est du sucre, ajouté ou naturel. Un plafond à part, parce que les mêmes 50 g ne pèsent pas pareil dans un fruit et dans un soda.</string>
    <string name="tour_fat_title">Lipides : en haut à gauche</string>
    <string name="tour_fat_body">Huile, beurre, fromage, oléagineux. Deux fois plus d\'énergie que les deux autres à poids égal, et c\'est pourquoi c\'est un plafond.</string>
    <string name="tour_fiber_title">Fibres : en bas à droite</string>
    <string name="tour_fiber_body">Légumes, légumineuses, céréales complètes. Le triangle que presque personne ne remplit, et un objectif comme les protéines.</string>
    <string name="tour_calendar_title">Sept jours d\'affilée</string>
    <string name="tour_calendar_body">Chaque pastille porte l\'avancement de son jour. Touchez-en une pour rattraper un repas oublié : la saisie ira sur ce jour-là.</string>
    <string name="tour_settings_title">Tout le reste est ici</string>
    <string name="tour_settings_body">Votre profil et vos objectifs, la clé d\'IA, la sauvegarde, les photos, les rappels et le thème. Rien ne quitte ce téléphone.</string>
    <string name="calendar_day_perfect_a11y">Le %1$d, journée dorée</string>
</resources>
