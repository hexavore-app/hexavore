<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">

    <string name="home_title">Today</string>
    <!-- The two days that have a name carry it: "Yesterday" reads faster than a date you
         have to decode. Beyond that, the long date takes over. -->
    <string name="home_title_yesterday">Yesterday</string>
    <string name="home_title_before_yesterday">The day before yesterday</string>

    <!-- The visible path back to today. The system back button leads there too, but a
         gesture with no visible representation cannot be found by someone who does not
         know it — the same rule as the swipe that deletes a row. -->
    <string name="home_back_to_today">Today</string>

    <!-- The figure shown is what is left, not what was eaten: that is the information
         you need at the moment of deciding what to eat. -->
    <string name="home_remaining_label">kcal left</string>
    <string name="home_over_label">kcal over</string>
    <string name="home_consumed_of_goal">%1$d eaten of %2$d</string>
    <string name="home_ring_a11y">Calories, %1$d of %2$d, %3$d %%</string>

    <!-- An empty list says what to do, not just that it is empty. -->
    <string name="home_empty_title">Nothing noted today</string>
    <string name="home_empty_body">The six counters will fill up with your first entry.</string>

    <!-- A failed read is said out loud, it does not show up as an empty day: an empty
         day is a claim, not an absence of answer. -->
    <string name="home_error_title">Log unreadable</string>
    <string name="home_error_body">The read did not go through. Nothing was changed: your dishes are where they were.</string>
    <string name="home_error_retry">Try again</string>

    <!-- As long as no target has been set. An invitation, not six empty gauges: a gauge
         at zero would suggest a target exists and is not being met. -->
    <string name="home_no_goal_title">No target yet</string>
    <string name="home_no_goal_body">Five questions are enough to work out your six targets. In the meantime, your totals are noted without being compared to anything.</string>
    <string name="home_no_goal_action">Set my target</string>

    <!-- An icon on its own: it is the least used door on this screen, and nothing should
         compete with the day\'s title for the first line of the eye. -->
    <string name="home_open_profile">Profile and targets</string>
    <string name="home_open_weight">Weight log</string>

    <!-- What was eaten stays accurate without a target: it is the comparison that is
         missing. No more "at least" form: the home screen no longer flags undercounted
         totals, and a value left blank reads as zero there (D119). -->
    <string name="home_total_line">%1$s: %2$d</string>

    <!-- No deletion is immediately final. The bar speaks of the dish: it is the only
         thing the home screen deletes now that swiping changes the day, and its label
         announced a row even for a whole dish. -->
    <string name="home_dish_deleted">Dish deleted</string>
    <string name="home_dish_undo">Undo</string>

    <!-- A row is a single accessibility node: name, quantity, calories, in one sentence
         rather than three stops. -->
    <string name="home_entry_a11y">%1$s, %2$s %3$s, %4$d kilocalories</string>

    <!-- A dish: several foods entered at once, placed by their time. -->
    <string name="home_dish_kcal">%1$d kcal</string>
    <!-- The whole dish is tappable. This label is what TalkBack announces after
         "double-tap to": without it, it would say "activate". -->
    <string name="home_dish_edit">edit this dish</string>

    <!-- The long press doubles the tap rather than replacing it: the tap opens editing,
         the menu gives access to what has no place on the dish itself. -->
    <string name="home_dish_menu">open the dish menu</string>
    <string name="home_dish_menu_edit">Edit</string>
    <string name="home_dish_menu_delete">Delete</string>
    <string name="home_dish_menu_favorite">Add to favourites</string>
    <string name="home_dish_menu_unfavorite">Remove from favourites</string>

    <!-- The three other ways to add, under the "+". Each one carries its name and a
         line that says what it opens: a glyph alone is recognised, never understood. -->
    <string name="home_open_favorites">Favourites</string>
    <string name="home_open_favorites_hint">Replay a dish you saved</string>
    <string name="home_scan">Scan</string>
    <string name="home_scan_hint">A barcode, and the product sheet with it</string>
    <string name="home_add_by_hand">Add by hand</string>
    <string name="home_add_by_hand_hint">Search the catalogue, or create the food yourself</string>
    <string name="home_more_ways">Other ways to add</string>

    <!-- The bottom bar. Writing what you ate is the most frequent gesture of the
         application, so it is the bar itself and not a button that opens a screen. -->
    <string name="home_describe_label">What did you eat?</string>
    <string name="home_describe_locked">Set up AI to describe your meals</string>
    <string name="home_send_description">Analyse this meal</string>
    <string name="home_shoot">Photograph the meal</string>
    <string name="home_analysing">Analysing…</string>
    <string name="home_analyse_cancel">Cancel</string>
    <!-- A provider that is down must never stop you from logging a meal. -->
    <string name="home_analyse_manual">Add by hand</string>

    <!-- Without a key, the field and the camera stay visible and explain when tapped:
         hidden, they are never learned; inert, they teach nothing either (D73). The
         dimming is invisible to a screen reader, hence this sentence. -->
    <string name="home_analyse_unavailable">unavailable, no AI key</string>

    <!-- What is missing, what it costs, and where to go. The button opens the AI section
         and not the hub: someone who has just tapped the camera is looking for the place
         to put a key, not for the list of settings. -->
    <string name="home_ai_title">Analyse a meal with AI</string>
    <string name="home_ai_explanation">Your photo or your description goes to the AI provider you choose, with your own key. They are the ones who bill you for their calls. Hexavore has no server.</string>
    <string name="home_ai_configure">Set up</string>
    <string name="home_ai_later">Later</string>

    <!-- The name is suggested from the foods in the dish, then freely rewritten: a
         favourite with no name could not be found, and an empty field would make you
         give up. -->
    <string name="home_favorite_title">Save as a favourite</string>
    <string name="home_favorite_body">You will find it under this name, ready to replay. Editing a line takes it out.</string>
    <string name="home_favorite_name">Dish name</string>
    <string name="home_favorite_name_taken">A favourite dish already has this name.</string>
    <string name="home_favorite_confirm">Save</string>
    <string name="home_favorite_cancel">Cancel</string>

    <!-- A dialog, where swiping a row makes do with its bar: this one takes n rows at
         once, and the number is said. -->
    <string name="home_dish_delete_title">Delete this dish?</string>
    <!-- In English "one" means exactly one, and zero falls into "other" — the opposite of
         French, where "one" covers zero too. The plural form therefore reads correctly
         for 0 as well, and the figure stays in both. -->
    <plurals name="home_dish_delete_body">
        <item quantity="one">%1$d line will be taken out of your day. You can undo it straight after.</item>
        <item quantity="other">%1$d lines will be taken out of your day. You can undo it straight after.</item>
    </plurals>
    <string name="home_dish_delete_confirm">Delete</string>
    <string name="home_dish_delete_cancel">Cancel</string>
    <string name="home_entry_quantity">%1$s %2$s</string>
    <string name="home_entry_kcal">%1$d kcal</string>

    <!-- What the dish contributes. The initial carries the same information as the
         colour: a colour never works on its own. -->
    <string name="home_macro_chip">%1$s %2$s</string>
    <string name="home_macro_grams">%1$s g</string>

    <string name="macro_calories">Calories</string>
    <string name="macro_protein">Protein</string>
    <string name="macro_carbs">Carbs</string>
    <string name="macro_sugars">Sugars</string>
    <string name="macro_fat">Fat</string>
    <string name="macro_fiber">Fibre</string>

    <!-- The bubble showing where a macro came from: what gave it to it, largest first.
         "Unknown value" is not "zero" — it is the only line on the home screen that
         still says a total is an undercount, and the only one that says which food is
         responsible. -->
    <string name="home_sources_of_goal">%1$s of %2$s</string>
    <string name="home_sources_unknown">Unknown value: %1$s</string>
    <string name="home_sources_open">Show the sources</string>
    <string name="home_sources_action">Show the sources: %1$s</string>
    <plurals name="home_sources_others">
        <item quantity="one">%1$d other</item>
        <item quantity="other">%1$d others</item>
    </plurals>

    <!-- The five chips are Protein, Carbs, Sugars, Fat and Fibre: those five have to be
         told apart from each other, and they are. Calories carry "kcal" rather than a
         letter — no chip shows them, they have their own figure at the top, and a "C"
         here would have read as Carbs the day someone did show them. -->
    <string name="macro_initial_calories">kcal</string>
    <string name="macro_initial_protein">P</string>
    <string name="macro_initial_carbs">C</string>
    <string name="macro_initial_sugars">S</string>
    <string name="macro_initial_fat">F</string>
    <string name="macro_initial_fiber">Fb</string>

    <!-- The calendar strip and the month view. A day with no entry is announced as such:
         to a screen reader, a missing ring is indistinguishable from an empty one, while
         the difference is the whole point. -->
    <string name="calendar_day_a11y">The %1$d, day noted</string>
    <string name="calendar_day_empty_a11y">The %1$d, no entry</string>
    <!-- A day still to come: it can be seen but not opened. Saying so saves you
         wondering why touching it does nothing. -->
    <string name="calendar_day_future_a11y">The %1$d, day still to come</string>
    <string name="calendar_close">Close</string>
    <!-- The handle. It carries the opening gesture because a vertical drag on the
         unfolded month belongs to that month\'s own scrolling. -->
    <string name="calendar_expand">Show the month</string>
    <string name="calendar_collapse">Back to the week</string>

    <!-- ===== Notices ==============================================================
         Each one designates a situation, never a message: it goes out when the situation
         ends, and none of them can be dismissed. The label says what there is to do,
         never "notification" — "1 notification" asks you to go and look. -->
    <string name="notice_ai_absent">No artificial intelligence configured</string>
    <string name="notice_ai_rejected">Your API key was refused</string>
    <string name="notice_weight_stale">No weight reading for a week</string>
    <string name="notice_yesterday_empty">Yesterday has nothing noted</string>

    <!-- La progression, en trois choses sur une ligne. L'ecran qui la deplie est a un
         tap : l'accueil repond deja a une question, et deux en pleine page rendraient
         la premiere moins nette. -->
    <plurals name="home_streak_days">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
    </plurals>
    <string name="home_level">Level %1$d</string>
    <string name="home_open_progress">Your progress</string>
    <string name="home_level_a11y">Level %1$d, %2$s logged in a row. Open your progress.</string>

    <!-- Ce qui passe a l'ecran quand un palier tombe. Rien a fermer : l'animation
         passe, et on continue a noter dessous. -->
    <string name="home_celebration_title">Milestone reached</string>
    <string name="home_badge_streak">%1$d days in a row</string>
    <string name="home_badge_volume">%1$d dishes logged</string>
    <string name="home_badge_perfect">%1$d golden days in a row</string>
    <string name="home_badge_first_scan">First scan</string>
    <string name="home_badge_first_photo">First photo</string>
    <string name="home_badge_first_text">First description</string>
    <string name="home_badge_first_favorite">First favourite</string>
    <!-- Au lancement qui suit un plantage : sur le moment, la pile se deroule et
         une boite ouverte depuis un gestionnaire d'exception ne marche qu'une fois
         sur deux (D138). -->
    <string name="crash_title">Hexavore closed on its own</string>
    <string name="crash_body">A technical trace was kept. It holds none of your meals, your weight or your key: class names and line numbers. You can read it before sending it.</string>
    <string name="crash_send">Send the report</string>
    <string name="crash_decline">No thanks</string>
    <string name="crash_subject">Hexavore closed on its own</string>
    <string name="crash_intro">Here is the trace of the last crash.</string>
    <!-- Le tour guide du premier lancement (D141). -->
    <string name="tour_day_title">Your day, at a glance</string>
    <string name="tour_day_body">The hexagon fills as you log, and the six counters say what is left. These meals are an example: they go when the tour ends.</string>
    <string name="tour_describe_title">Say it in your own words</string>
    <string name="tour_describe_body">« Porridge with milk and a banana ». The AI reads the sentence, finds the foods and weighs them. You check, you correct, you save.</string>
    <string name="tour_photo_title">Or photograph the plate</string>
    <string name="tour_photo_body">One shot, and you can add a word if the picture is ambiguous. What you write wins over what is seen.</string>
    <string name="tour_more_title">And when you prefer to be exact</string>
    <string name="tour_more_body">A barcode, the catalogue of 3,484 foods offline, or a dish you saved. These three never need a key.</string>
    <string name="tour_ai_title">Gemini is free</string>
    <string name="tour_ai_body">The sentence and the photo need a key. Google gives one away: a few analyses a day cost nothing, and no card is asked for. Two minutes is enough.</string>
    <string name="tour_degraded_title">Without a key, two gestures are missing</string>
    <string name="tour_degraded_body">The field and the camera stay red: everything else works, and you can set a key up whenever you like from Settings. Nothing is lost in the meantime.</string>
    <string name="tour_next">Next</string>
    <string name="tour_skip">Skip</string>
    <string name="tour_done">Got it</string>
    <string name="tour_later">Later</string>
    <string name="tour_configure">Set it up</string>
    <string name="tour_calories_title">Calories: the top triangle</string>
    <string name="tour_calories_body">The top of the hexagon, and the big number right below it: the energy you have left for the day. The triangle grows as you eat, and spills past the outline if you go over.</string>
    <string name="tour_protein_title">Protein: right of the top</string>
    <string name="tour_protein_body">What builds and repairs muscle. A target to reach, not a ceiling: this is a triangle you want filled to the edge.</string>
    <string name="tour_carbs_title">Carbs: the bottom triangle</string>
    <string name="tour_carbs_body">The main fuel: bread, pasta, rice, fruit. It is a ceiling, so a triangle past the outline is a warning, not an achievement.</string>
    <string name="tour_sugars_title">Sugars: lower left</string>
    <string name="tour_sugars_body">The share of carbs that is sugar, added or natural. A ceiling of its own, because the same 50 g do not weigh the same in fruit and in a soda.</string>
    <string name="tour_fat_title">Fat: upper left</string>
    <string name="tour_fat_body">Oil, butter, cheese, nuts. Twice the energy of the other two for the same weight, which is why it is a ceiling.</string>
    <string name="tour_fiber_title">Fibre: lower right</string>
    <string name="tour_fiber_body">Vegetables, pulses, whole grains. The triangle almost nobody fills, and a target like protein.</string>
    <string name="tour_calendar_title">Seven days in a row</string>
    <string name="tour_calendar_body">Each dot carries its day\'s progress. Tap one to log a meal you forgot: the entry lands on that day, not today.</string>
    <string name="tour_settings_title">Everything else is here</string>
    <string name="tour_settings_body">Your profile and targets, the AI key, backup, photos, reminders and the theme. Nothing leaves this phone.</string>
    <string name="calendar_day_perfect_a11y">The %1$d, a golden day</string>
</resources>
