<?xml version="1.0" encoding="utf-8"?>
<resources>

    <string name="progress_title">Progress</string>
    <string name="progress_close">Close progress</string>

    <!-- Two streaks, and they do not measure the same thing: one says you are logging,
         the other says you are holding your range. -->
    <string name="progress_streak_logging">Logging streak</string>
    <string name="progress_streak_logging_hint">Days in a row with at least one dish</string>
    <string name="progress_streak_perfect">Golden streak</string>
    <string name="progress_streak_perfect_hint">Days in a row spent inside your range</string>

    <plurals name="progress_days">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
    </plurals>

    <string name="progress_level">Level %1$d</string>
    <!-- Plurals on the first number, for languages that need them (D162). -->
    <plurals name="progress_level_points">
        <item quantity="one">%1$d of %2$d points towards the next level</item>
        <item quantity="other">%1$d of %2$d points towards the next level</item>
    </plurals>

    <!-- Every milestone is shown, taken or not: a hidden one makes nobody want
         anything. Those not taken are dimmed and carry no date. -->
    <string name="progress_badges">Milestones</string>
    <string name="progress_family_streak">Regularity</string>
    <string name="progress_family_volume">Volume</string>
    <string name="progress_family_perfect">Accuracy</string>
    <string name="progress_family_discovery">First times</string>

    <!-- Plurals, names and hints alike: the first golden milestone falls at one day, and
         read "1 golden days in a row" (D162). -->
    <plurals name="progress_name_streak">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days in a row</item>
    </plurals>
    <plurals name="progress_name_volume">
        <item quantity="one">%1$d dish logged</item>
        <item quantity="other">%1$d dishes logged</item>
    </plurals>
    <plurals name="progress_name_perfect">
        <item quantity="one">%1$d golden day</item>
        <item quantity="other">%1$d golden days in a row</item>
    </plurals>
    <string name="progress_name_first_scan">First scan</string>
    <string name="progress_name_first_photo">First photo</string>
    <string name="progress_name_first_text">First description</string>
    <string name="progress_name_first_favorite">First favourite</string>

    <plurals name="progress_hint_streak">
        <item quantity="one">Log something for %1$d day</item>
        <item quantity="other">Log something %1$d days running</item>
    </plurals>
    <plurals name="progress_hint_volume">
        <item quantity="one">Log %1$d dish</item>
