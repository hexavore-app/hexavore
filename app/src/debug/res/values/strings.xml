<?xml version="1.0" encoding="utf-8"?>
<!--
  Texts for the debug variant only. Like the gallery they serve, they are absent from the
  release binary.

  They used to carry a comment saying nobody would ever have to translate them. That
  stopped being true the day `values/` became English: a French string in the fallback
  bucket is a lie about the bucket, and Android Lint would have asked for the French
  anyway. Thirty-one short strings were cheaper than an exception.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">

    <string name="gallery_launcher_label">Hexavore — gallery</string>
    <string name="gallery_title">Component gallery</string>
    <string name="gallery_subtitle">Design system check screen. No real data: these values are samples.</string>
