<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Les rappels de repas (D134). Demandee a l'execution sur Android 13 et
         au-dela ; en dessous, poster une notification ne demande rien. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".HexavoreApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hexavore"
        android:usesCleartextTraffic="false">

        <!--
          La fenetre se retrecit quand le clavier s'ouvre, et c'est dit ici.

          Elle le faisait deja, par defaut, sans que personne l'ait ecrit : l'ecran
          posait donc par-dessus une marge de clavier qui s'ajoutait a un
          retrecissement deja fait, et la barre du bas remontait de deux hauteurs de
          clavier. Le defaut se corrige en declarant ce sur quoi on s'appuie, pas en
          compensant ce qu'on n'a pas declare (D153).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Hexavore">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- L'initialiseur par defaut de WorkManager est retire : il construit son
             propre Configuration avant que Hilt soit pret, et un @HiltWorker recevrait
             alors la fabrique par defaut, qui ne sait rien de ses dependances.
             HexavoreApplication fournit la configuration a la place. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
