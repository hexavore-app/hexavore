<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- One channel for all four reminders. Four would let you mute lunch without
         muting dinner, which the app's own settings already do better. -->
    <string name="reminder_channel">Meal reminders</string>
    <string name="reminder_channel_description">A nudge when a meal has not been logged, and one in the evening when a streak is at stake.</string>

    <!-- Each one only rings when it still has something to say: the lunch reminder
         stays quiet once lunch is logged. -->
    <string name="reminder_breakfast_title">Breakfast?</string>
    <string name="reminder_breakfast_body">Nothing logged yet this morning.</string>
    <string name="reminder_lunch_title">Lunch?</string>
    <string name="reminder_lunch_body">A sentence is enough — Hexavore works out the rest.</string>
    <string name="reminder_dinner_title">Dinner?</string>
    <string name="reminder_dinner_body">Your day is nearly done. One last entry?</string>

    <!-- The only one that speaks of progress, and the only one with something to
         lose. Still no reproach: it says what is at stake, not what was missed. -->
    <string name="reminder_streak_title">Your streak is at stake</string>
    <string name="reminder_streak_body">Nothing logged today. One dish keeps it running.</string>

</resources>
